; Run one map to its terminal viewport with the raster disabled. Then rewind
; exactly as restart does before seeding the independent deadline test.
sectorTest:
.stream:
    call streamSceneryTile
    ld a,(barrelScrollComplete)
    or a
    jr z,.stream
sectorStreamDone:
    call rewindBarrel

; Test-only initializer in bank 0. The production loop and its addresses
; remain identical. The first Frame 2 expires eight blasts, then accepts five
; fresh hits on the right-hand copies. Scroll passes 79 -> 0 during the blasts.
sectorSeed:
    call gameInit
    ld a,78
    ld (tileMapScroll_H),a
    ld a,8
    ld (sceneryBlastCount),a
    ld hl,sceneryBlasts
    ld de,18+28*256
    ld b,8
.seedBlast:
    ld (hl),e : inc hl
    ld (hl),d : inc hl
    ld (hl),1 : inc hl
    inc e : inc d
    djnz .seedBlast
    ld hl,tileMap+18 : ld de,tileMap+28 : ld b,8
    ld a,BLAST_TILE+2
.seedTile:
    ld (hl),a : inc hl
    ld (de),a : inc de
    djnz .seedTile
    dup PLAYER_PAIRS,i
        ld hl,(3+i*8)+20*256
        ld (player_pairs+2*i),hl
        xor a
        ld (tileMap+36+10+i),a
        ld a,DESTRUCTIBLE_TILE+(i%4)
        ld (tileMap+54+i),a
        ld (tileMap+64+i),a
    edup
    ifdef STRESS_CATALOG
    ; Place all fifteen ships one movement step before their first gun.
    ld hl,catalogStressPositions
    ld de,enemy_boxes
    ld ix,enemyMotion
    ld iy,sprite09
    ld bc,WAVE_ENEMIES*256             ; B = ships left, C = path slot 0..5
.ship:
    dup 2
        ld a,(hl) : inc hl : ld (de),a : inc de
    edup
    ld a,c : add a,high catalogPaths : add a,a : or (hl) : inc hl
    ld (ix),a : inc ix : inc ix
    ld a,c : add a,high enemyArt+2
    ld (iy+SPRITE.IMAGE+1),a
    ld (iy+SPRITE.IMAGE),0
    push de : ld de,SPRITE : add iy,de : pop de
    inc c : ld a,c : cp 6
    jr nz,.nextShip
    ld c,0
.nextShip:
    djnz .ship
    else
    dup WAVE_ENEMIES,i
        ld hl,(23+2*i)+(1+5*(i%3))*256
        ld (enemy_boxes+2*i),hl
        if i>=8
            ld a,(residentCount)
            dec a
            jr z,1f
            ld a,YELLOW_APPROACH
            ld (enemyMotion+2*i),a
            ld hl,yellowArt
            ld (sprite09+i*SPRITE+SPRITE.IMAGE),hl
1:
        endif
    edup
    endif
    ld hl,sectorTestBullets
    ld de,enemy_records
    ld bc,ENEMY_COUNT*3
    ldir
    ifdef STRESS_BONUS_LIFE
        ; Start with a full row of wide icons. The first real hit awards the
        ; 19th spare while the projectile, sprite and scenery pools are busy.
        ld hl,#4999             ; the kill crosses 500,000
        ld (hudScore),hl
        ld a,19
        ld (playerLives),a
        ld a,(1<<HUD_SCORE_DIRTY)|(1<<HUD_TENS_DIRTY)|(1<<HUD_LIVES_DIRTY)
        ld (hudPending),a
.primeHud:
        call hudStep
        ld a,(hudPending)
        or a
        jr nz,.primeHud
        ld a,1
        ld (collision_actual),a
    endif
    jp syncActors
sectorTestBullets:
    dup ENEMY_COUNT,i
        db 17+i,4+(i%5)*6,(i%4)*8
    edup
    ifdef STRESS_CATALOG
catalogStressPositions: incbin "catalog-stress.bin"
    endif
