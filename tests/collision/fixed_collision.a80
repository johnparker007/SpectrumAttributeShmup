PLAYER_HITBOX_WIDTH equ 3

; Fixed-time box checks. Positions are relative to the playfield.
; A' accumulates #ff for hit, 0 for miss. The loop always evaluates both axes.
    macro FIXED_BOX_SCAN width,boxWidth
.next:
    ld a,(de)
    inc de
    sub c
    if width=2
        inc a                  ; shot can start one dot left of the box
    endif
    cp boxWidth+width-1
    sbc a,a
    ld l,a
    ld a,(de)
    inc de
    sub h
    cp 5
    sbc a,a
    and l
    ld l,a
    ifdef OVERLAY_MOTION
        if width=1
            inc de             ; incoming record's trajectory byte
        endif
    endif
    ex af,af'
    or l
    ex af,af'
    djnz .next
    endm

collisionInit:
    ld hl,enemy_boxes
    ld (next_box),hl
    ld hl,collision_actual
    ld (next_result),hl
    ld hl,enemy_positions
    ld (next_shot),hl
    xor a
    ld (player_hit),a
    jp collisionIncomingTwo

collisionPair:
    call collisionEnemy
    jp collisionIncomingTwo

collisionEnemy:
    ld ix,(next_box)
    ld c,(ix)
    ld h,(ix+1)
    ifdef LIVE_SHMUP
    ld de,player_pairs
    ld b,PLAYER_PAIRS
    xor a
    ex af,af'
.pair:
    ld a,(de)
    cp 63
    sbc a,a
    ld l,a                      ; ignore spent pairs and positions outside the viewport
    ld a,(de)
    sub c
    inc a                       ; the bullet is two dots wide
    cp 6
    sbc a,a
    and l
    ld l,a
    inc de
    ld a,(de)
    sub h
    add a,PLAYER_PAIR_GAP        ; the two vertical hit ranges meet across a 5-dot box
    cp 5+PLAYER_PAIR_GAP
    sbc a,a
    and l
    ld l,a
    ex af,af'
    or l
    ex af,af'
    dec de
    ld a,(de)
    or l                        ; retire the whole pair before checking the next box
    ld (de),a
    inc de
    inc de
    djnz .pair
    ld b,5                      ; 73 T-states match the original nine-shot scan
.delay:
    djnz .delay
    inc de
    else
    ld de,player_positions
    ld b,9
    xor a
    ex af,af'
    FIXED_BOX_SCAN 2,5
    endif
    ex af,af'
    ld hl,(next_result)
    ld (hl),a
    inc hl
    ld (next_result),hl
    inc ix
    inc ix
    ld (next_box),ix
    ret

collisionIncomingTwo:
    ld hl,(player_box)
    ld c,l
    ld de,(next_shot)
    ld b,2
    ld a,(player_hit)
    ex af,af'
    ifdef LIVE_SHMUP
        FIXED_BOX_SCAN 1,PLAYER_HITBOX_WIDTH
    else
        FIXED_BOX_SCAN 1,5
    endif
    ex af,af'
    ld (player_hit),a
    ld (next_shot),de
    ret

    ifndef LIVE_SHMUP
verifyCollision:
    ld hl,collision_actual
    ld de,collision_expected
    ld bc,16
.next:
    ld a,(de)
    cpi
    jp nz,overlayFailed
    inc de
    jp pe,.next
    ret
    endif

next_box: dw 0
next_result: dw 0
next_shot: dw 0
collision_actual: defs 15,0
player_hit: db 0

    ifndef LIVE_SHMUP
enemy_boxes: incbin "enemy_boxes.bin"
player_box: incbin "player_box.bin"
collision_expected: incbin "collision_expected.bin"
    endif
