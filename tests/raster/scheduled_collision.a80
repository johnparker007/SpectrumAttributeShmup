; Split the fixed collision workload around the stock large-sprite OUTs.
    assert $=#c3c2
    ld iyl,8
attrBufferCorrection: ld hl,0
    ld sp,collision_stack_top
    call collisionInit         ; initialize and scan the first two enemy dots
    ifdef OVERLAY_MOTION
        ld bc,821
    else
        ld bc,833
    endif
    call DELAY
    exx
    jp collision_shadow

deltaFrame: ld bc,0            ; target of the removed large-sprite animation patch

    defs #c431-$
collision_shadow:
    out (c),h
    exx
    call collisionPair         ; one enemy box and two dots against the player
    ifdef LEVEL_WAVES
        call drawSkyStar
    else
        ifdef OVERLAY_MOTION
            ld bc,354
        else
            ld bc,366
        endif
        call DELAY
    endif
    exx
    jp collision_normal

    defs #c4e2-32-$
    defs 32,0
collision_stack_top:
collision_normal:
    out (c),l
    exx
    dec iyl
    jr z,collision_last
    call collisionPair
    ifdef OVERLAY_MOTION
        ld bc,403
    else
        ld bc,415
    endif
    call DELAY
    exx
    jp collision_shadow

collision_last:
    ld bc,499
    call DELAY
    ld bc,0
    jp collision_phase_end

    defs #c53f-$
collision_phase_end:
