; Draw into the active buffer after stock Frame 2 and before Frame 1 copies it.
ROW_BYTES equ attrBufferWidth
HEIGHT equ 48                   ; physical attribute buffer height
    ifdef BOTTOM_HUD
PLAYFIELD_HEIGHT equ 46
ENEMY_COUNT equ 24
    else
PLAYFIELD_HEIGHT equ HEIGHT
ENEMY_COUNT equ 32
    endif
CYAN equ 5
YELLOW equ 6
; The timed collision slices still read two records in each of sixteen slots.
COLLISION_ENEMY_RECORDS equ 32
    include "packed_plot.a80"

overlayEntry:
    ifdef OVERLAY_AUDIO
        call soundTick
        ld a,0                 ; sound wrapper plus 7 keeps HALT phase
    endif
overlayBegin:
    ifdef LIVE_SHMUP
        call checkPlayerContact
        ifdef LEVEL_WAVES
            call sceneryStep
        endif
        call expandPlayerPairs
        ld a,(playerLives)
        or a
        jp z,overlayEnd
    endif
    ld hl,(attrPointer)
    ifdef OVERLAY_FAST_PLOT
        ld (dotViewport+1),hl
    else
        ld (viewport),hl
    endif
    PLOT_PLAYERS
overlayEnemies:
    ifdef LEVEL_WAVES
    jp drawIncomingDots
; One active projectile. BC retains the viewport origin, D remains zero.
plotIncomingDot:
    ld e,l
    ld a,h : add a,a : ld l,a : ld h,high row_offsets
    ld a,(hl) : inc l : ld h,(hl) : ld l,a
    add hl,bc
    srl e
    jr c,.paper
    add hl,de
    ld a,(hl) : and #f8
.ink: or YELLOW
    ld (hl),a
    ret
.paper:
    add hl,de
    ld a,(hl) : and #c7
.paperColour: or YELLOW << 3
    ld (hl),a
    ret
    defs 47-($-overlayEnemies)  ; same footprint as the original packed-dot loop
    else
    PLOT_ENEMIES
    endif
overlayEnd:
    ifdef LIVE_SHMUP
        ifdef BOTTOM_HUD
            nop : nop : nop   ; preserve the fixed-bank overlay layout
        else
            call hudAttributes
        endif
hudAttributesDone:
        call hudStep
hudFrame2Done:
    ifndef GAME_OVER_MUSIC
        call gameOverAttributes
        call gameOverStep
        call gameOverStep
    endif
    endif
    ifndef OVERLAY_MOTION
    ; Confirm untouched lane selection at two opposite viewport edges.
    ld hl,(viewport)
    ld a,(hl)
    and #3f
    cp YELLOW | (CYAN << 3)
    jp nz,overlayFailed
    inc hl
    ld a,(hl)
    and 7
    cp CYAN
    jp nz,overlayFailed

    ld de,47*ROW_BYTES+29      ; HL is already one byte past the viewport base
    add hl,de
    ld a,(hl)
    and #38
    cp CYAN << 3
    jp nz,overlayFailed
    inc hl
    ld a,(hl)
    and 7
    cp YELLOW
    jp nz,overlayFailed

    ifdef SCHEDULE_COLLISION
        ifndef OVERLAY_PHRASES
            call verifyCollision
            ld a,0             ; 841-T-state passing check plus 7 keeps HALT phase
        endif
    endif
    ld a,0                     ; preserve the stock four-T-state HALT phase
    endif
    ifdef OVERLAY_FAST_PLOT
        inc de                 ; 1,038 T-states saved, plus 6 preserves HALT phase
    endif
    ifdef LEVEL_WAVES
        jp finishCatalogShots
    else
        jp mainLoop
    endif

overlayFailed:
    di
    halt

    DOT_ADDRESS
    DOT_ROW_OFFSETS

viewport: dw 0
    ifdef OVERLAY_MOTION
        ifdef LIVE_SHMUP
            include "gameplay.a80"
        else
            include "moving_overlay.a80"
        endif
    else
player_positions: incbin "player_positions.bin"
enemy_positions: incbin "enemy_positions.bin"
    endif

    ifdef SCHEDULE_COLLISION
        include "fixed_collision.a80"
    endif
    ifdef OVERLAY_AUDIO
        include "engine_stream.a80"
    endif
