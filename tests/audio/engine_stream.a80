; The engine harness needs a constant cost modulo four to keep HALT phase.
; Each event is 96 T-states. Pointer wrap adds 16 T-states.
soundScroll:
    ifdef BONUS_AUDIO
    call soundTick
    jp doSinScroll
    else
    ld a,(sound_initialized)
    or a
    jr nz,sound_initialized_continue
    ld a,1
    ld (sound_initialized),a
    call soundTickBody          ; initialize from the first packet in Frame 1
    ld a,0                     ; match the recurring branch modulo four
    ifdef OVERLAY_PHRASES
        inc de
        jp sound_initialized_tick
    endif
sound_initialized_continue:
    ifdef OVERLAY_PHRASES
        ifndef OVERLAY_MOTION
            ifdef SCHEDULE_COLLISION
                call verifyCollision
                ld a,0         ; 841-T-state passing check plus 7 keeps HALT phase
            endif
        endif
    endif
sound_initialized_tick:
    ld a,0
    call soundTick
    ld a,r                      ; complete a multiple of four with JP
    jp doSinScroll
    endif

soundTick:
    call soundTickBody
    ifdef LIVE_SFX
soundEffectsCall:
        call soundEffectsTick
    endif
soundTickEnd:
    ret

    ifdef OVERLAY_PHRASES
    include "engine_phrases.a80"
    else
soundTickBody:
    ld hl,(sound_cursor)
    ld c,#fd
sound_next:
    ld a,(hl)
    inc hl
    cp #ff
    jr z,sound_complete
    ld b,#ff
soundSelect:
    out (c),a
    ld b,#bf
    ld a,(hl)
    inc hl
soundWrite:
    out (c),a
    inc de
    jr sound_next
sound_complete:
    ld de,testAudioStreamEnd
    or a
    push hl
    sbc hl,de
    pop hl
    jp nz,sound_store
    ld hl,testAudioLoop
    inc de
sound_store:
    ld (sound_cursor),hl
    ret

sound_cursor: dw testAudioStream
    endif
sound_initialized: db 0
