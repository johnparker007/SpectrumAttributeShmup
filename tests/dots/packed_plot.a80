    macro PLOT_LIST listBase,listCount
    ifdef OVERLAY_FAST_PLOT
        ld de,listBase
    else
        ld ix,listBase
    endif
    ld b,listCount
    endm

    macro FETCH_DOT stride
    ifdef OVERLAY_FAST_PLOT
        ld a,(de)
        inc de
        ex af,af'              ; preserve X while loading Y
        ld a,(de)
        inc de
        if stride=3
            inc de
        endif
        exx                    ; preserve the list cursor and loop count
    endif
    call dot_address
    endm

    macro NEXT_DOT stride
    ifdef OVERLAY_FAST_PLOT
        exx
    else
        dup stride : inc ix : edup
    endif
    endm

    macro PLOT_PLAYERS
    PLOT_LIST player_positions,9
.loop:
    FETCH_DOT 2
    jr c,.split

    ; Aligned 2x1 shot. Retain BRIGHT and FLASH from the pair underneath.
    ld a,(hl)
    and #c0
    or CYAN | (CYAN << 3)
    ld (hl),a
    ifdef OVERLAY_MOTION
        ld a,0
        dup 5 : nop : edup     ; 27 Ts, matching the split shot
    endif
    jr .next
.split:
    ; Odd starting X spans the paper field and the next byte's ink field.
    ld a,(hl)
    and #c7
    or CYAN << 3
    ld (hl),a
    inc hl
    ld a,(hl)
    and #f8
    or CYAN
    ld (hl),a
.next:
    NEXT_DOT 2
    djnz .loop
    endm

    macro PLOT_ENEMIES
    PLOT_LIST enemy_positions,ENEMY_COUNT
.loop:
    ifdef OVERLAY_MOTION
        FETCH_DOT 3
    else
        FETCH_DOT 2
    endif
    jr c,.paper
    ld a,(hl)
    and #f8
    or YELLOW
    ld (hl),a
    jr .next
.paper:
    ld a,(hl)
    and #c7
    or YELLOW << 3
    ld (hl),a
    ifdef OVERLAY_MOTION
        ld a,0                 ; match the even-X branch's jump cost
    endif
.next:
    ifdef OVERLAY_MOTION
        NEXT_DOT 3
    else
        NEXT_DOT 2
    endif
    djnz .loop
    endm

; Input IX -> x,y. Return HL = active attrPointer + 38*y + floor(x/2).
; Carry is set for paper (odd X). Keep B for the outer loop's count.
    macro DOT_ADDRESS
dot_address:
    ifndef OVERLAY_FAST_PLOT
    ld a,(ix+1)
    endif
    add a,a
    ld l,a
    ld h,high row_offsets
    ld e,(hl)
    inc l
    ld d,(hl)
    ifdef OVERLAY_FAST_PLOT
dotViewport: ld hl,0
    else
    ld hl,(viewport)
    endif
    add hl,de
    ifdef OVERLAY_FAST_PLOT
        ex af,af'
    else
        ld a,(ix)
    endif
    srl a
    ld e,a
    ld d,0
    ex af,af'
    add hl,de
    ex af,af'
    ret
    endm

    macro DOT_ROW_OFFSETS
    align 256
row_offsets:
    dup HEIGHT, row
        dw ROW_BYTES*row
    edup
    endm
