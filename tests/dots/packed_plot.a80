    macro PLOT_PLAYERS
    ld ix,player_positions
    ld b,9
.loop:
    call dot_address
    jr c,.split

    ; Aligned 2x1 shot. Retain BRIGHT and FLASH from the pair underneath.
    ld a,(hl)
    and #c0
    or CYAN | (CYAN << 3)
    ld (hl),a
    jr .next
.split:
    ; Odd starting X spans the paper field and the next byte's ink field.
    ld a,(hl)
    and #c7
    or CYAN << 3
    ld (hl),a
    inc hl
    ld a,(hl)
    and #f8
    or CYAN
    ld (hl),a
.next:
    inc ix
    inc ix
    djnz .loop
    endm

    macro PLOT_ENEMIES
    ld ix,enemy_positions
    ld b,ENEMY_COUNT
.loop:
    call dot_address
    jr c,.paper
    ld a,(hl)
    and #f8
    or YELLOW
    ld (hl),a
    jr .next
.paper:
    ld a,(hl)
    and #c7
    or YELLOW << 3
    ld (hl),a
.next:
    inc ix
    inc ix
    djnz .loop
    endm

; Input IX -> x,y. Return HL = active attrPointer + 38*y + floor(x/2).
; Carry is set for paper (odd X). Keep B for the outer loop's count.
    macro DOT_ADDRESS
dot_address:
    ld a,(ix+1)
    add a,a
    ld l,a
    ld h,high row_offsets
    ld e,(hl)
    inc l
    ld d,(hl)
    ld hl,(viewport)
    add hl,de
    ld a,(ix)
    srl a
    ld e,a
    ld d,0
    ex af,af'
    add hl,de
    ex af,af'
    ret
    endm

    macro DOT_ROW_OFFSETS
    align 256
row_offsets:
    dup HEIGHT, row
        dw ROW_BYTES*row
    edup
    endm
