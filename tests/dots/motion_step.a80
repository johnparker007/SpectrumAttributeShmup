    macro MOVE_VOLLEYS
    ld ix,volleys
    ld de,player_shots
    ld b,3
.next:
    ld a,(ix)
    cp 62
    jr nc,.retire
    inc a
    ld (ix),a
    ld c,a
    ld a,(ix+2)
    inc a
    ld (ix+2),a
    srl a
    ld h,a                      ; spread grows by one dot every two ticks
    ld l,(ix+1)
    ld a,l
    sub h
    call write_shot
    ld a,l
    call write_shot
    ld a,l
    add a,h
    call write_shot
    jr .advance
.retire:
    ld (ix),#ff
    ld c,#ff
    xor a
    call write_shot
    call write_shot
    call write_shot
.advance:
    inc ix
    inc ix
    inc ix
    djnz .next
    endm

    macro MOVE_ENEMIES
    ld hl,enemy_records
    ld d,high trajectories
    ld b,ENEMY_COUNT
.next:
    ld a,(hl)
    cp #ff
    jr z,.skip
    sub 1
    jr c,.retire_x
    ld (hl),a
    inc hl
    inc hl
    ld a,(hl)
    ld c,a
    ; Increment packed phase bits 0-2 while keeping trajectory bits 3-5.
    inc a
    xor c
    and 7
    xor c
    ld (hl),a
    ld e,a
    dec hl
    ld a,(de)
    add a,(hl)
    cp 48
    jr nc,.retire_y
    ld (hl),a
    inc hl
    inc hl
    djnz .next
    jr .done
.retire_y:
    dec hl
.retire_x:
    ld (hl),#ff
.skip:
    inc hl
    inc hl
    inc hl
    djnz .next
.done:
    endm

    macro MOTION_WRITE_SHOT
; A is the candidate Y, C the shared volley X. Preserve HL and B.
write_shot:
    cp 48
    jr nc,.outside
    push af
    ld a,c
    ld (de),a
    inc de
    pop af
    ld (de),a
    inc de
    ret
.outside:
    ld a,#ff
    ld (de),a
    inc de
    xor a
    ld (de),a
    inc de
    ret
    endm
