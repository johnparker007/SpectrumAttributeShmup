; Sector handoff in the bank 0 gap before the wave controller.
    ifdef LEVEL_MENU
bossSectorCleared:
    pop hl                            ; waveController and motionStep return addresses
    pop hl
    di
    call disableRender
    xor a
    ld e,a                            ; silence all three AY amplitudes
    call swapPage
    ifdef LIVE_SFX
        ld a,8 : call writeSoundEffect
        ld a,9 : call writeSoundEffect
        ld a,10 : call writeSoundEffect
    endif
    ld a,(selectedLevel)
    ld e,a : ld d,0
    ld hl,levelATotals : add hl,de
    ld a,(sceneryAHits)
    ld e,a : ld a,(hl) : sub e
    ld d,a                           ; D = misses for the results line
    ld e,0
    ld a,(hl) : or a                 ; a map without targets earns no bonus
    jr z,sectorBonusCredited
    ld a,d : cp 4
    jr nc,sectorBonusCredited
    ld hl,sectorBonusHundreds
    ld c,a : ld b,0 : add hl,bc
    ld b,(hl) : ld e,b              ; E = hundreds awarded, preserved by hudAward
.credit:
    call hudAward
    djnz .credit
sectorBonusCredited:
    call showSectorResults
    ld a,(selectedLevel)
    cp 8
    jp z,selectNextLevel
    add a,'2'
    ld (readyLevel),a
    ld hl,(hudScore) : push hl
    ld a,(playerLives) : push af
    ei
    call showSectorReady
    call prepareSelectedLevel
    call gameInit
    pop af : ld (playerLives),a
    pop hl : ld (hudScore),hl
    ld a,(1<<HUD_SCORE_DIRTY)|(1<<HUD_LIVES_DIRTY)|(1<<HUD_TENS_DIRTY)
    ld (hudPending),a
    call bossFinishHud
    jp startLevelRenderer

sectorBonusHundreds: db 100,50,20,10

bossFinishHud:
    call hudStep
    ld a,(hudPending)
    or a
    jr nz,bossFinishHud
    ld a,(hudRow)
    cp 8
    jr nz,bossFinishHud
    ret
    else
bossSectorCleared:
    ld hl,bossQuiet
    ld (waveController+1),hl
    ret
    endif
