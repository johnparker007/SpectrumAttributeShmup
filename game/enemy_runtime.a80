; Game logic runs with bank 0 mapped. This code and the sprites live above AY data.
    macro sampleGreenY
        and 63
        exx
        ld l,a
        ld a,(de)
        or l
        ld l,a
        ld a,(hl)
        exx
    endm
stepWave:
    exx
    ld h,high shipTrajectories
    ld de,enemyMotion
    exx
    ld hl,enemy_boxes
    ld de,collision_actual
    ld b,WAVE_ENEMIES
    ld a,(gameTick)
    ld c,a
.next:
    ld a,(hl)
    cp HIDDEN_BOX
    jr z,.exploding
    ld a,(de)
    or a
    jr nz,.hit
    ifdef LEVEL_WAVES
        exx
        ld a,(de)
        exx
        or a
        jp m,.yellow
    endif
    bit 0,c                       ; resolve hits every tick, move on even ticks
    jr nz,.skipY
    dec (hl)
    ld a,(hl)
    cp #fb                       ; a five-dot sprite is fully offscreen at X=-5
    jr z,.hide
    ifdef LEVEL_WAVES
.fireAtColumn:
        cp HIDDEN_BOX
        jp z,.armedGreen
    endif
    sampleGreenY
    inc hl
    ld (hl),a
    jr .advance
.hit:
    exx
    inc de
    ld a,EXPLOSION_TICKS
    ld (de),a
    dec de
    exx
    ifdef LIVE_SFX
        call startExplosionSound
    endif
    ld a,(playerLives)
    or a
    jr z,.hide
    push hl
    ld hl,enemyKills
    inc (hl)
    call hudAward
    pop hl
.hide:
    ld (hl),HIDDEN_BOX
    jr .skipY
.exploding:
    exx
    inc de
    ld a,(de)
    or a
    jr z,.blastReady
    dec a
    jr nz,.saveBlast
    dec a                        ; restore normal art in the sprite update
.saveBlast:
    ld (de),a
.blastReady:
    dec de
    exx
.skipY:
    inc hl
.advance:
    ifdef LEVEL_WAVES
    ; Each table of slot records fits within a single page.
    assert high enemy_boxes=high (enemy_boxes+2*WAVE_ENEMIES-1)
    assert high collision_actual=high (collision_actual+WAVE_ENEMIES-1)
    assert high enemyMotion=high (enemyMotion+2*WAVE_ENEMIES-1)
    inc l
    inc e
    exx
    inc e : inc e
    exx
    else
    inc hl
    inc de
    exx
    inc de
    inc de
    exx
    endif
    ifdef LEVEL_WAVES
        dec b
        jp nz,.next
    else
        djnz .next
    endif

    ld hl,spawnWait
    ld a,(hl)
    or a
    jr z,.findSlot
    dec (hl)
    ret
.findSlot:
    ifdef LEVEL_WAVES
        ld a,(barrelScrollComplete)
        or a
        jp nz,finishLastWave
    endif
.spawnNormally:
    ld a,(spawnSlot)
    add a,a
    ld e,a
    ld d,0
    ld hl,enemy_boxes
    add hl,de
    ld ix,enemyMotion
    add ix,de
    ld a,(hl)
    cp HIDDEN_BOX
    ret nz
    ld a,(ix+1)
    or a
    ret nz
    ld (hl),67                   ; four steps before the top left enters at X=63
    inc hl
    ld (hl),21
    ld a,(waveIndex)
    ifdef LEVEL_WAVES
        call spawnLevelShip
    else
        rrca
        rrca
        ld (ix),a
    endif
    ifdef LEVEL_WAVES
.spawnDelay:
    endif
    ld a,9
    ld (spawnWait),a
    ld a,(spawnSlot)
    inc a
    cp WAVE_ENEMIES
    jr c,.saveSlot
    xor a
.saveSlot:
    ld (spawnSlot),a
    ld hl,waveRemaining
    dec (hl)
    ret nz
    ifdef LEVEL_WAVES
        jp advanceLevelWave
    else
    ld (hl),WAVE_ENEMIES
    ld a,(waveIndex)
    inc a
    and 3
    ld (waveIndex),a
    ret
    endif

    ifdef LEVEL_WAVES
.armedGreen:
    sampleGreenY
    inc hl
    ld (hl),a
    dec hl
    ld a,(hl)
    call queueGreenShot
    jp .skipY
.yellow:
    bit 5,a                     ; scripted path page encoded in bits 1-7
    jp nz,moveCatalogShip
    call moveYellow
    jp .advance
    endif

; Packed trajectory bits 3–7 select the bearing and bits 0–2 select its phase.
moveIncoming:
incomingPage:
    ld d,high incomingX
    ; Sparse fire leaves most slots empty. An untaken call costs less than
    ; advancing the three-byte pointer and counting each empty slot.
    if high enemy_records=high (enemy_end-1)
        ld h,high enemy_records
        define DOT_CURSOR l
    else
        define DOT_CURSOR hl
    endif
    dup ENEMY_COUNT, slot
        if high enemy_records=high (enemy_end-1)
            ld l,low (enemy_records+slot*3)
        else
            ld hl,enemy_records+slot*3
        endif
        ld a,(hl)
        or a
        call p,moveDot           ; live X is 0..63, empty X is #ff
    edup
    ret

moveDot:
    ld c,a
    inc DOT_CURSOR
    inc DOT_CURSOR
    ld a,(hl)
    inc a
    xor (hl)
    and 7
    xor (hl)
    ld e,a
    ld a,(de)
    add a,c
    cp 64
    jr nc,.retire
    ld c,a
    ld (hl),e
    dec DOT_CURSOR
    inc d                        ; Y table follows X on the next page
    ld a,(de)
    dec d
    add a,(hl)
    cp PLAYFIELD_HEIGHT
    jr nc,.retireY
    ld (hl),a
    dec DOT_CURSOR
    ld (hl),c
    ret
.retire:
    dec DOT_CURSOR
.retireY:
    dec DOT_CURSOR
    ld (hl),#ff
    ret
    undefine DOT_CURSOR

spawnIncoming:
    ifdef LEVEL_WAVES
        call emitYellowShots
        ld hl,(greenShot)
        ld a,l
        inc a
        ret z
        ld a,#ff
        ld (greenShot),a
        ld b,l
        ld c,h
        xor a
    else
    ld a,(gameTick)
    and 7
    ret nz                       ; one firing opportunity per eight game ticks
    ld hl,spreadWait
    ld a,(hl)
    or a
    jr z,.select
    dec (hl)
.select:
    ld a,(fireSlot)
    ld e,a
    inc a
    cp WAVE_ENEMIES
    jr c,.nextSlot
    xor a
.nextSlot:
    ld (fireSlot),a
    ld d,0
    sla e
    ld hl,enemy_boxes
    add hl,de
    ld a,(hl)
    cp 64
    ret nc                        ; the selected ship is offscreen or exploding
    ld b,a
    inc hl
    ld a,(hl)
    add a,2
    ld c,a
    ld hl,enemyMotion
    add hl,de
    ld a,(hl)
    and #40                      ; ship paths 1 and 3 use the three-way spread
    jr z,aimQueuedShot
    ld hl,spreadWait
    ld a,(hl)
    or a
    ret nz
    ld (hl),2                    ; at least sixteen ticks between spreads
    inc a                        ; mark this shot as a spread
    endif
aimQueuedShot:
    push af
    ld d,0
    ld a,(playerLives)
    or a
    jr z,.aimReady
    ld a,(respawnWait)
    or a
    call z,aimIncoming
.aimReady:
    pop af
    ifdef LEVEL_WAVES
        jr emitIncoming
    else
    jr z,emitIncoming
    call emitIncoming            ; centre, then 22.5 degrees either side
    ld a,d
    sub 16
    ld d,a
    call emitIncoming
    ld a,d
    add a,32
    ld d,a
    endif
emitIncoming:
    ld hl,(enemyWrite)
    ld a,(hl)
    inc a
    ret nz
    ld (hl),b
    inc hl
    ld (hl),c
    inc hl
    ld (hl),d
enemyShotEmitted:
    inc hl
    ld a,l
    cp low enemy_end
    jr nz,.save
    ld hl,enemy_records
.save:
    ld (enemyWrite),hl
    ret

    ifdef LEVEL_WAVES
; X crosses the configured column only once. Spawn spacing allows at most
; one queued shot per tick, which is emitted after existing shots move.
queueGreenShot:
    ld (greenShot),a
    inc hl
    ld a,(hl)
    dec hl
    add a,2
    ld (greenShot+1),a
    ret

configureLevelWaves:
    ld l,a
    add a,a
    add a,l
    add a,a                      ; six profile bytes per level
    ld e,a
    ld d,0
    ld hl,levelWaveProfiles
    add hl,de
    ld a,(hl)
    ld (stepWave.fireAtColumn+1),a
    inc hl
    ld a,(hl)
    or a
    ld a,high incomingSlowX
    jr z,.speed
    ld a,high incomingX
.speed:
    ld (incomingPage+1),a
    inc hl
    ld a,(hl)
    ld (yellowFireMode),a
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (levelWaveGaps),de
    inc hl
    ld a,(hl)
    ld (finishCatalogShots.volleyEnd+1),a
    cp 64
    ld hl,aimIncoming
    jr z,.aim
    ld hl,volleyAim
.aim:
    ld (catalogBearing.aim+1),hl
    ret

resetLevelWaves:
    ifdef BONUS_AUDIO
        call restoreWaveMusic
    endif
    ld hl,stepWave
    ld (waveController+1),hl
    ld hl,spawnIncoming
    ld (gunController+1),hl
    ld hl,PLAYER_START
    ld (volleyAim+1),hl
    ld a,(greenStartPhase)
    xor #40                      ; a retry starts with the opposite entrance
    ld (greenStartPhase),a
    ld (waveIndex),a
    ld a,#ff
    ld (moveCatalogShip.shotMask+1),a
    ld (greenShot),a
    ld (yellowMidShot),a
    ld (yellowEndShot),a
    jp startWaveOrder

greenStartPhase: db #40
greenShot: dw #ff
levelWaveProfiles: incbin "level_fire.bin"

    include "yellow_z.a80"
    endif

    include "aim_incoming.a80"

checkPlayerContact:
    ld bc,(player_box)
    ld a,c
    cp HIDDEN_BOX
    ret z
    ; The five-dot enemy overlaps the three-dot player when dx is -4..2.
    ; The byte subtraction also handles clipped enemy X.
    dup WAVE_ENEMIES, slot
        ld hl,(enemy_boxes+slot*2)
        ld a,l
        sub c
        add a,4
        cp 5+PLAYER_HITBOX_WIDTH-1
        jr nc,1f
        ld a,h
        sub b
        add a,4
        cp 9
        jr nc,1f
        ld hl,collision_actual+slot
        jp .hit
1:
    edup
    ret
.hit:
    ld a,#ff
    ld (player_hit),a
    ld a,(invincibleTicks)
    or a
    ret nz
    ld (hl),#ff                  ; the first overlapping enemy shares the ram
    ret

syncEnemyShips:
    ; DE is the display offset. An explosion retains the last drawn position.
    dup WAVE_ENEMIES, slot
        ld a,(enemyMotion+slot*2+1)
        or a
        jr z,1f
        cp #ff
        jr nz,2f
        xor a
        ld (enemyMotion+slot*2+1),a
        ld hl,enemyArt
        ld (sprite09+slot*SPRITE+SPRITE.IMAGE),hl
        jr 1f
2:
        call explosionArt
        ld (sprite09+slot*SPRITE+SPRITE.IMAGE),hl
        jr 3f
1:
        ld hl,(enemy_boxes+slot*2)
        ld a,l
        add a,e                  ; negative playfield X lands in the left pad
        ld l,a
        ld a,h
        add a,d                  ; apply the Y offset without carry from X
        ld h,a
        ld (sprite09+slot*SPRITE+SPRITE.X),hl
3:
    edup
    ret

explosionArt:
    add a,a
    add a,low explosionFrames
    ld l,a
    ld h,high explosionFrames
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ret

    align 16
explosionFrames:
    dw explosion3,explosion3,explosion3,explosion2,explosion2,explosion1,explosion1
explosion1: incbin "explosion_1.bin"
explosion2: incbin "explosion_2.bin"
explosion3: incbin "explosion_3.bin"
    ifndef LEVEL_WAVES
enemyArt: incbin "enemy_art.bin",0,60
    endif
playerArt: incbin "player_art.bin"

    align 256
shipTrajectories: incbin "ship_trajectories.bin"
    align 256
incomingX: incbin "incoming_x.bin"
incomingY: incbin "incoming_y.bin"
    assert incomingY-incomingX=256
aimThresholds: incbin "aim_thresholds.bin"
    assert low aimThresholds=0
    ifdef LEVEL_WAVES
incomingSlowX: incbin "incoming_slow_x.bin"
incomingSlowY: incbin "incoming_slow_y.bin"
    assert low incomingSlowX=0
    assert incomingSlowY-incomingSlowX=256
    endif
