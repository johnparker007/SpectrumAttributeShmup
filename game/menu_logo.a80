; Menu-only beam timing in uncontended bank 2.
menuLogoFrame:
    halt
    di
    ld (menuLogoHostStack+1),sp
    call patchMenuLogoRows
    call seedMenuLogoRows
    ld bc,5298
    call DELAY
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af

menuLogoRaster:
    dup 8*MENU_LOGO_ROWS, line
        ld sp,MENU_LOGO_ATTRS+MENU_LOGO_WIDTH+32*(line/8)
        dup MENU_LOGO_PAIRS
            push bc
        edup
        ; Pad one contended 28-byte transfer to a 228-T-state scanline.
        jr $+2
        inc sp
        nop
    edup

menuLogoRasterEnd:
menuLogoHostStack:
    ld sp,0
    ld bc,34655
    call DELAY
menuLogoBorder:
    call menuMusicPage
    call menuTrackTick
    xor a
    call swapPage
    call advanceMenuLogoPalette
menuLogoFrameDone:
    ei
    ret

menuLogoPalette: defs MENU_LOGO_PAIR_BYTES
