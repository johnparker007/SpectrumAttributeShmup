; Menu-only beam timing in bank 2. The ULA sees bank 5 for the first four
; scanlines of each logo character row and bank 7 for the other four.
MENU_LOGO_WIDTH equ 28
MENU_LOGO_ROWS equ 4
MENU_LOGO_LEFT equ (32-MENU_LOGO_WIDTH)/2
MENU_LOGO_TOP equ 1
MENU_LOGO_PIXELS equ #4000+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_ATTRS equ #5800+32*MENU_LOGO_TOP+MENU_LOGO_LEFT

drawMenuLogo:
    di
    ld de,MENU_LOGO_PIXELS
    call copyMenuLogo
    ld a,7
    call swapPage
    ; Gameplay may have left visible pixels beside the logo in the shadow screen.
    ld hl,#d800+32*MENU_LOGO_TOP
    ld de,#d800+32*MENU_LOGO_TOP+1
    ld bc,32*MENU_LOGO_ROWS-1
    xor a
    ld (hl),a
    ldir
    ld de,MENU_LOGO_PIXELS+#8000
    call copyMenuLogo
    xor a
    call swapPage
    xor a
    ld (menuLogoClock),a
    call updateMenuLogoColours
    ei
    ret

copyMenuLogo:
    ld hl,menuLogoBitmap
    ld a,8
.scanline:
    ld ixl,MENU_LOGO_ROWS
.row:
    ld bc,MENU_LOGO_WIDTH
    ldir
    dup 32-MENU_LOGO_WIDTH
        inc de
    edup
    dec ixl
    jr nz,.row
    ld e,low MENU_LOGO_PIXELS
    inc d
    dec a
    jr nz,.scanline
    ret

menuLogoFrame:
    halt
    di
    ; Aim the first switch at the left border of paper scanline 12.
    ld bc,16595
    call DELAY
    ld bc,#7ffd
    ld d,2*MENU_LOGO_ROWS
    ld a,#18
menuLogoSwitch:
    out (c),a
    dec d
    jp z,menuLogoEnd
    ; 912 T-states between writes, including both paging and loop overhead.
    ld b,66
    djnz $
    ld b,#7f
    xor 8
    jr menuLogoSwitch

menuLogoEnd:
    ; The display has switched back to bank 5. Wait for the bottom border.
    ld bc,34685
    call DELAY
menuLogoBorder:
    call menuMusicPage
    call menuTrackTick
    xor a
    call swapPage
    ld hl,menuLogoClock
    inc (hl)
    ld a,(hl)
    and 3
    jr nz,menuLogoFrameDone
    call updateMenuLogoColours
menuLogoFrameDone:
    ei
    ret

updateMenuLogoColours:
    ld a,(menuLogoClock)
    rrca : rrca
    and 15
    push af
    ld de,MENU_LOGO_ATTRS
    call fillMenuLogoColours
    ld a,7
    call swapPage
    pop af
    inc a
    ld de,MENU_LOGO_ATTRS+#8000
    call fillMenuLogoColours
    xor a
    jp swapPage

fillMenuLogoColours:
    ld ixl,MENU_LOGO_ROWS
.row:
    and 15
    push af
    ld c,a
    ld b,0
    ld hl,menuLogoPalette
    add hl,bc
    dup MENU_LOGO_WIDTH
        ldi
    edup
    dup 32-MENU_LOGO_WIDTH
        inc de
    edup
    pop af
    add a,2
    dec ixl
    jr nz,.row
    ret

menuLogoClock: db 0
menuLogoPalette:
    dup 3
        db #41,#41,#43,#43,#42,#42,#46,#46,#47,#47,#44,#44,#45,#45,#05,#01
    edup
