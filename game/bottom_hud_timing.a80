; Start the bottom tile row during the former HUD attribute-copy interval.
; Shifted tiles merge their left edge with the preceding tile's right edge.
HUD_PREPARED_TILE equ 45
HUD_TILE_BUFFER equ attrBufferStart + 8 + (HUD_PREPARED_TILE%9)*4 + 8*attrBufferWidth*(HUD_PREPARED_TILE/9)
; The stack walks its tile pixels here, so this block cannot CALL or PUSH.
prepareHudTile:
    ld sp,(renderTilesList+HUD_PREPARED_TILE*2)
    ld a,(tileMapScroll_H)
    rrca
    jp c,hudTileShifted
ADDR = HUD_TILE_BUFFER
    DRAW_TILE_LINES 6
    jp hudTileWait
hudTileShifted:
ADDR = HUD_TILE_BUFFER
    DRAW_TILE_LINES_SHIFTED 6
    jp hudTileWait
hudTileWait:
    ld a,(tilesPage2_16)
    cp #16
    jp nz,hudTilePlus2a
    ; Copy contention in the old interval differs by model. Match the
    ; original first visible tile swap at 22478 T-states on 128K.
    ld b,22
    djnz $
    ld a,0
    ld a,0
    jp hudTileDone
hudTilePlus2a:
    ; Match the original swap at 22525 T-states on +2A.
    ld b,23
    djnz $
    nop
    ld a,0
    jp hudTileDone

    ifdef LIVE_SFX
        align 256
soundMusicRegisters: defs 14    ; indexed by AY register while the literal bank is mapped
    endif
    assert $<=#be00             ; IM 2 builds its vector table here at startup
