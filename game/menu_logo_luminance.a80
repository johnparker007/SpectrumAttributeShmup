; Experimental menu raster. Generated code borrows the gameplay attribute
; buffer while rendering is disabled. The three entry points have fixed addresses.
menuLogoFrame:
    jp runLuminanceFrame
menuLogoRasterExit:
    jp menuLogoHostStack
menuLogoSeedExit:
    jp menuLogoSeedStack
    assert menuLogoRasterExit=#8003 && menuLogoSeedExit=#8006
    assert MENU_LOGO_ATTRS=#5822 && MENU_LOGO_WIDTH=28 && MENU_LOGO_ROWS=4
MENU_LOGO_PREFIX equ 64
MENU_LOGO_PROGRAM_SIZE equ 960
menuCopperRows equ attrBuffer+MENU_LOGO_PROGRAM_SIZE
menuCopperStack equ menuCopperRows+1024
    assert menuCopper128SourceEnd-menuCopper128Source+16<=1024
    assert menuCopperPlusSourceEnd-menuCopperPlusSource+16<=1024
    assert menuCopperStack<=renderTilesList

initMenuCopper:
    ld a,(2899)
    cp 159
    ld hl,menuCopper128Source
    ld bc,menuCopper128SourceEnd-menuCopper128Source
    jr z,.copy
    ld hl,menuCopperPlusSource
    ld bc,menuCopperPlusSourceEnd-menuCopperPlusSource
.copy:
    ld de,menuCopperRows
    ldir
    ret

runLuminanceFrame:
    call menuMusicPage
    ld hl,luminance128
    ld bc,655
    ld a,(2899)
    cp 159                         ; 128K / grey +2 ROM identifier
    jr z,.selectPhase
    ld hl,luminancePlus
    ld bc,663
.selectPhase:
    ld (menuLogoDelay+1),bc
    ld a,(menuLogoPhase)
    add a,a
    ld e,a
    ld d,0
    push hl
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    pop hl
    add hl,de
    ; Seed the first scanlines from the banked program during the bottom border.
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    add hl,de
    ld (menuLogoSeedStart+1),hl
    call seedLuminanceRows
    pop hl
    ld de,attrBuffer
    ld bc,MENU_LOGO_PREFIX
    call copyMenuProgram
    ld (menuLogoCopySource+1),hl
    xor a
    call swapPage
    ei
menuLogoWaitRaster:
    halt
    di
    ld (menuLogoHostStack+1),sp
    call menuMusicPage
menuLogoCopySource:
    ld hl,0
    ld de,attrBuffer+MENU_LOGO_PREFIX
    ld bc,MENU_LOGO_PROGRAM_SIZE-MENU_LOGO_PREFIX
    call copyMenuProgram
    xor a
    call swapPage
menuLogoDelay:
    ld bc,0                      ; Wait after the fixed-size top-border copy.
    call DELAY
    ld a,(#5800)                  ; Contention aligns the first raster instruction.
    ld sp,menuLogoPalette
    ; Only BC, DE and HL supply ink pairs. Keep the calibrated load time.
    pop bc : pop de : pop hl : pop af : pop ix : pop iy
    jp attrBuffer

menuLogoHostStack:
    ld sp,0
    ld (menuCopperHostStack+1),sp
    ld sp,menuCopperStack
    jp menuCopperRows

menuCopperDone:
menuCopperHostStack:
    ld sp,0
    call menuMusicPage
    call menuTrackTick
    xor a
    call swapPage
    ld hl,menuLogoPhase
    inc (hl)
    ld a,(hl)
    cp MENU_LOGO_PHASES
    jr c,menuLogoFrameDone
    ld (hl),0
menuLogoFrameDone:
    ei
    ret

copyMenuProgram:
    dup 32
        ldi
    edup
    jp pe,copyMenuProgram
    ret

seedLuminanceRows:
    ld (menuLogoSeedStack+1),sp
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af : pop ix : pop iy
menuLogoSeedStart:
    jp 0
menuLogoSeedStack:
    ld sp,0
    ret

clearMenuRaster:
    xor a
    ld hl,attrBuffer
    ld (hl),a
    ld de,attrBuffer+1
    ld bc,menuCopperStack-attrBuffer-1
    ldir
    ret

menuLogoPhase: dw 0
menuLogoPalette: incbin "gfx/luminance-inks.bin"
