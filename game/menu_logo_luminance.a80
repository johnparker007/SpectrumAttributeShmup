; Experimental menu raster. Generated code borrows the gameplay attribute
; buffer while rendering is disabled. The three entry points have fixed addresses.
menuLogoFrame:
    jp runLuminanceFrame
menuLogoRasterExit:
    jp menuLogoHostStack
menuLogoSeedExit:
    jp menuLogoSeedStack
    assert menuLogoRasterExit=#8003 && menuLogoSeedExit=#8006
    assert MENU_LOGO_ATTRS=#5842 && MENU_LOGO_WIDTH=28 && MENU_LOGO_ROWS=4
MENU_LOGO_PREFIX equ 64
MENU_LOGO_PROGRAM_SIZE equ 960
menuCopperRows equ attrBuffer+MENU_LOGO_PROGRAM_SIZE
menuCopperStack equ menuCopperRows+2000
    assert menuCopper128SourceEnd-menuCopper128Source+16<=2000
    assert menuCopperPlusSourceEnd-menuCopperPlusSource+16<=2000
    assert menuCopperStack<=renderTilesList

initMenuCopper:
    ld a,(2899)
    cp 159
    ld hl,menuCopper128Source
    ld bc,menuCopper128SourceEnd-menuCopper128Source
    ld de,menuCopperRows+menuGold128Source-menuCopper128Source
    jr z,.copy
    ld hl,menuCopperPlusSource
    ld bc,menuCopperPlusSourceEnd-menuCopperPlusSource
    ld de,menuCopperRows+menuGoldPlusSource-menuCopperPlusSource
.copy:
    ld (menuLogoTopBar+1),de
    ld de,menuCopperRows
    ldir
    jp initMenuStars

runLuminanceFrame:
    di
    ld hl,luminance128Programs
    ld bc,595
    ld a,(2899)
    cp 159                         ; 128K / grey +2 ROM identifier
    jr z,.selectPhase
    ld hl,luminancePlusPrograms
    ld bc,604
.selectPhase:
    ld (menuLogoDelay+1),bc
    ld a,(menuLogoPhase)
    ld e,a
    add a,a
    add a,e
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    ld (menuLogoProgramPage+1),a
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    call pageMenuLogoProgram
    ex de,hl
    ; Seed the first scanlines from the banked program during the bottom border.
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    add hl,de
    ld (menuLogoSeedStart+1),hl
    call seedLuminanceRows
    pop hl
    ld de,attrBuffer
    ld bc,MENU_LOGO_PREFIX
    call copyMenuProgram
    ld (menuLogoCopySource+1),hl
    xor a
    call swapPage
    ei
menuLogoWaitRaster:
    halt
    di
    ld (menuLogoHostStack+1),sp
    call pageMenuLogoProgram
menuLogoCopySource:
    ld hl,0
    ld de,attrBuffer+MENU_LOGO_PREFIX
    ld bc,MENU_LOGO_PROGRAM_SIZE-MENU_LOGO_PREFIX
    call copyMenuProgram
    xor a
    call swapPage
menuLogoDelay:
    ld bc,0
    call DELAY
menuLogoTopBar:
    jp 0
menuLogoGate:
    ld a,(#5800)                  ; Contention aligns the first raster instruction.
    ld sp,menuLogoPalette
    ; Seed setup has already loaded the alternate colour pairs.
    pop bc : pop de : pop hl : pop af : pop ix : pop iy
    jp attrBuffer

menuLogoHostStack:
    ld sp,0
    ld (menuCopperHostStack+1),sp
    ld sp,menuCopperStack
    jp menuCopperRows

menuCopperDone:
menuCopperHostStack:
    ld sp,0
    call menuMusicPage
    call menuTrackTick
    xor a
    call swapPage
    call stepMenuStars
    ld hl,menuLogoPhase
    inc (hl)
    ld a,(hl)
    cp MENU_LOGO_PHASES
    jr c,menuLogoFrameDone
    ld (hl),0
menuLogoFrameDone:
    ei
    ret

pageMenuLogoProgram:
    di
menuLogoProgramPage:
    ld a,0
    jp swapPage

copyMenuProgram:
    dup 32
        ldi
    edup
    jp pe,copyMenuProgram
    ret

seedLuminanceRows:
    ld (menuLogoSeedStack+1),sp
    exx
    ld bc,(menuLogoPalette+8)
    ld de,(menuLogoPalette+10)
    ld hl,(menuLogoPalette+12)
    exx
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af : pop ix : pop iy
menuLogoSeedStart:
    jp 0
menuLogoSeedStack:
    ld sp,0
    ret

clearMenuRaster:
    xor a
    ld hl,attrBuffer
    ld (hl),a
    ld de,attrBuffer+1
    ld bc,menuCopperStack-attrBuffer-1
    ldir
    ret

menuLogoPhase: dw 0
menuLogoPalette: incbin "gfx/luminance-inks.bin"

initMenuStars:
    call colourMenuStarRows
    MENU_STAR_LAYOUT 1
    ret

; C and B hold the old and new masks, HL the bitmap address and DE the
; address operand to update. Wrap to the last byte of the same row.
stepMenuStarCrossByte:
    ld a,c
    xor (hl)
    ld (hl),a
    dec l
    ld a,l
    and 31
    cp 31
    jr nz,.save
    ld a,l
    add a,32
    ld l,a
.save:
    ld a,l
    ld (de),a
    ld a,b
    xor (hl)
    ld (hl),a
    ret

; The last four star updates live in fixed RAM to fit the menu banks.
stepMenuStarsFixed:
    MENU_STAR_FIXED_LAYOUT 0
    ret

; Set the ink on star-only character rows once per menu redraw.
colourMenuStarRows:
    ld hl,menuStarRowColours
.next:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,d
    or a
    ret z
    ld a,(hl)
    inc hl
    ld b,32
.fill:
    ld (de),a
    inc e
    djnz .fill
    jr .next
menuStarRowColours:
    ; Attribute address and bright ink on black paper.
    dw #5800+7*32 : db #45
    dw #5800+8*32 : db #42
    dw #5800+9*32 : db #47
    dw #5800+11*32 : db #41
    dw #5800+12*32 : db #44
    dw #5800+13*32 : db #43
    dw #5800+14*32 : db #46
    dw #5800+15*32 : db #45
    dw #5800+17*32 : db #47
    dw #5800+19*32 : db #42
    dw #5800+20*32 : db #46
    dw #5800+21*32 : db #41
    dw #5800+22*32 : db #43
    dw #5800+23*32 : db #44
    dw 0
