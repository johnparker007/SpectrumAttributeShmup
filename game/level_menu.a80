; The menu occupies the normal screen with the raster renderer disabled.
    ifdef BOTTOM_HUD
        define GAME_OVER_MUSIC
    endif
showLevelMenu:
    di
    call disableRender
    xor a
    call swapPage
    call drawLevelMenu
    call menuMusicPage
    call menuTrackInit
    call menuMusicRestore
    jr menuWait

drawLevelMenu:
    call clearMenuScreen
    call drawMenuLogo
    ld hl,menuStartPrompt
    ld de,#4846               ; row 10, near centre of the character grid
    call drawScreenText
    ld hl,menuLevels
    ld de,#5008               ; row 16
    call drawScreenText
    ld hl,menuRedefinePrompt
    ld de,#5048               ; row 18
    call drawScreenText
    xor a
    ld (menuFireArmed),a
    ret

menuWait:
    call menuLogoFrame
    ld bc,#fbfe                ; Q, W, E, R, T
    in a,(c)
    bit 3,a
    jr z,menuRedefine
    ld b,#f7                   ; keyboard row 1 to 5
    in a,(c)
    ld d,a
    and #1f
    cp #1f
    jr z,.rightRow
    ld a,'1'
    ld b,5
.leftKeys:
    srl d
    jr nc,menuSelected
    inc a
    djnz .leftKeys
.rightRow:
    ld b,#ef                 ; keyboard row 0, 9, 8, 7, 6
    in a,(c)
    ld e,2
    bit 0,a                   ; Sinclair fire (0) wins over its direction keys.
    jr z,menuStartOnFire
    ld d,a
    and #1e
    cp #1e
    jr z,.fire
    srl d
    ld a,'9'
    ld b,4
.rightKeys:
    srl d
    jr nc,menuSelected
    dec a
    djnz .rightKeys
.fire:
    ld e,0
menuKeyboardFire:
    ld a,#7f
    in a,(#fe)
    and 1                     ; Patched when the player redefines Fire.
    jr z,menuStartOnFire
    inc e
menuKempstonFire:
    in a,(#1f)
    and #f0
    cp #10                    ; Require fire and reject a floating bus (#ff).
    jr z,menuStartOnFire
    ld a,1
    ld (menuFireArmed),a
    jr menuWait

menuStartOnFire:
    ld a,(menuFireArmed)
    or a
    jr z,menuWait              ; A held button on menu entry must be released.
    call setMenuControl
    ld a,'1'
    jr menuSelected

menuRedefine:
    call redefineKeys
    call drawLevelMenu
    jr menuWait

menuSelected:
    ld (readyLevel),a
    call menuMusicPage
    call menuTrackMute
    call menuMusicRestore
showSectorReady:
    call clearMenuScreen
    ld hl,readyTitle
    ld de,#484b               ; row 10, column 11
    call drawScreenText
    ld hl,readyCaption
    ld de,#4888               ; row 12, column 8
    call drawScreenText
    halt
    ld a,(readyLevel)
    sub '1'
    call loadLevel
    ld b,35
.hold:
    halt
    djnz .hold
prepareLevelScreens:
    di
    ifdef LUMINANCE_LOGO
        call clearMenuRaster
    endif
    call fillScreens
    call fillPixels
    ei
    ret

returnToMenu:
    pop hl                         ; discard the return from motionStep
selectNextLevel:
    call showLevelMenu
restartSelectedLevel:
    call prepareSelectedLevel
    jp levelPrepared
prepareSelectedLevel:
    di
    call rewindBarrel
    ; The first render pass otherwise reads the old level's buffer and tile list.
    xor a
    ld hl,attrBuffer
    ld de,attrBuffer+1
    ld bc,renderTilesList-attrBuffer-1
    ld (hl),a
    ldir
    call processTileMap

    xor a
    ifndef GAME_OVER_MUSIC
    ld (gameOverRows),a
    endif
    ld (hudPending),a
    ld (sound_initialized),a
    ld (phrase_left),a
    ld h,a
    ld l,a
    ld (hudScore),hl
    ld a,32                        ; a held Enter must be released before another restart
    ld (restartHeld),a
    ifndef BOTTOM_HUD
    ld (hudDrawn),hl
    endif
    ld a,STARTING_LIVES
    ld (playerLives),a
    ifndef BOTTOM_HUD
    ld (hudLivesDrawn),a
    endif
    ld a,8
    ld (hudRow),a
    ld a,#40
    ld (greenStartPhase),a
    ld hl,testAudioRecipe
    ld (phrase_next),hl
    ret

; The PT3 player and its self-modifying state share logical bank 3.
menuFrame:
    halt
    call menuMusicPage
    call menuTrackTick
    jr menuMusicRestore

menuMusicPage:
    di
    ld a,3
    jp swapPage

menuMusicRestore:
    xor a
    call swapPage
    ei
    ret

setMenuControl:
    ld a,e
    add a,a
    ld e,a
    ld d,0
    ld hl,menuReaders
    add hl,de
    ld c,(hl)
    inc hl
    ld b,(hl)
    ld (controlReader+1),bc
    ret

clearMenuScreen:
    xor a
    ld hl,#4000
    ld de,#4001
    ld bc,6144-1
    ld (hl),a
    ldir
    ld a,#47
    ex de,hl
    ld (hl),a
    ld de,#5801
    ld bc,768-1
    ldir
    ret

menuStartPrompt: db "PRESS FIRE TO START",0
menuLevels: db "1-9 TEST LEVELS",0
menuRedefinePrompt: db "R REDEFINE KEYS",0
menuFireArmed: db 0
menuReaders: dw readControls,readKempston,readSinclair
readyTitle: db "GET READY",0
readyCaption: db "ENTERING LEVEL "
readyLevel: db "1",0

gameOverText: incbin "game_over.bin"
    assert $-gameOverText=GAME_OVER_WIDTH*GAME_OVER_ROWS

    include "redefine_keys.a80"
    include "menu_logo_setup.a80"

menuLogoBitmap: incbin "gfx/blokius-logo.bin"
    assert $-menuLogoBitmap=8*MENU_LOGO_WIDTH*MENU_LOGO_ROWS
    ifdef LUMINANCE_LOGO
        include "menu_stars.a80"
    endif
