; The menu occupies the normal screen with the raster renderer disabled.
showLevelMenu:
    di
    call disableRender
    xor a
    call swapPage
    call drawLevelMenu
    call menuMusicPage
    call menuTrackInit
    call menuMusicRestore
    jr menuWait

drawLevelMenu:
    call clearMenuScreen
    call drawMenuLogo
    ld hl,menuLevels
    ld de,#4846               ; row 10, centered
    call drawScreenText
    ld hl,menuControlChoices
    ld de,#5001               ; row 16
    call drawScreenText
    ld hl,menuSinclairChoice
    ld de,#5041               ; row 18
    call drawScreenText
    ld a,(menuControl)
    jp showControlMark

menuWait:
    call menuLogoFrame
    ld bc,#fbfe                ; Q, W, E, R, T
    in a,(c)
    bit 3,a
    jr z,menuRedefine
    call pollMenuControls
    ld bc,#f7fe                ; keyboard row 1 to 5
    in a,(c)
    ld d,a
    ld a,'1'
    ld b,5
.leftKeys:
    srl d
    jr nc,menuSelected
    inc a
    djnz .leftKeys
    ld b,#ef                 ; keyboard row 0, 9, 8, 7, 6
    in a,(c)
    rrca
    rrca
    ld d,a
    ld a,'8'
    ld b,3
.rightKeys:
    srl d
    jr nc,menuSelected
    dec a
    djnz .rightKeys
    jr menuWait

menuRedefine:
    call redefineKeys
    call drawLevelMenu
    jr menuWait

menuSelected:
    ld (readyLevel),a
    call menuMusicPage
    call menuTrackMute
    call menuMusicRestore
    call clearMenuScreen
    ld hl,readyTitle
    ld de,#484b               ; row 10, column 11
    call drawScreenText
    ld hl,readyCaption
    ld de,#4888               ; row 12, column 8
    call drawScreenText
    halt
    ld a,(readyLevel)
    sub '1'
    call loadLevel
    ld b,35
.hold:
    halt
    djnz .hold
    di
    call fillScreens
    call fillPixels
    ei
    ret

returnToMenu:
    pop hl                         ; discard the return from motionStep
    call showLevelMenu
    di
    call rewindBarrel
    ; The first render pass otherwise reads the old level's buffer and tile list.
    xor a
    ld hl,attrBuffer
    ld de,attrBuffer+1
    ld bc,renderTilesList-attrBuffer-1
    ld (hl),a
    ldir
    call processTileMap

    xor a
    ld (gameOverRows),a
    ld (restartHeld),a
    ld (hudPending),a
    ld (sound_initialized),a
    ld (phrase_left),a
    ld h,a
    ld l,a
    ld (hudScore),hl
    ld (hudDrawn),hl
    ld a,STARTING_LIVES
    ld (playerLives),a
    ld (hudLivesDrawn),a
    ld a,8
    ld (hudRow),a
    ld a,#40
    ld (greenStartPhase),a
    ld hl,testAudioRecipe
    ld (phrase_next),hl
    jp levelPrepared

; The PT3 player and its self-modifying state share logical bank 3.
menuFrame:
    halt
    call menuMusicPage
    call menuTrackTick
    jr menuMusicRestore

menuMusicPage:
    di
    ld a,3
    jp swapPage

menuMusicRestore:
    xor a
    call swapPage
    ei
    ret

pollMenuControls:
    ld bc,#bffe               ; Enter, L, K, J, H
    in a,(c)
    bit 2,a
    ld e,0
    jr z,selectControls
    inc e
    bit 3,a
    jr z,selectControls
    ld b,#fd                  ; A, S, D, F, G
    in a,(c)
    bit 1,a
    ret nz
    inc e
selectControls:
    ld a,(menuControl)
    cp e
    ret z
    push de
    call controlMarkAddress
    ld hl,menuNoMark
    call drawScreenText
    pop de
    ld a,e
    ld (menuControl),a
    add a,a
    ld e,a
    ld d,0
    ld hl,menuReaders
    add hl,de
    ld c,(hl)
    inc hl
    ld b,(hl)
    ld (controlReader+1),bc
    ld a,(menuControl)
showControlMark:
    call controlMarkAddress
    ld hl,menuMark
    jp drawScreenText

controlMarkAddress:
    add a,a
    ld e,a
    ld d,0
    ld hl,menuMarkAddresses
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ret

clearMenuScreen:
    xor a
    ld hl,#4000
    ld de,#4001
    ld bc,6144-1
    ld (hl),a
    ldir
    ld a,#47
    ex de,hl
    ld (hl),a
    ld de,#5801
    ld bc,768-1
    ldir
    ret

menuLevels: db "1-8  START LEVEL 1-8",0
menuControlChoices: db "K KEYBOARD     J KEMPSTON",0
menuSinclairChoice: db "S SINCLAIR     R REDEFINE KEYS",0
menuMark: db ">",0
menuNoMark: db " ",0
menuControl: db 0
menuMarkAddresses: dw #5000,#500f,#5040
menuReaders: dw readControls,readKempston,readSinclair
readyTitle: db "GET READY",0
readyCaption: db "ENTERING LEVEL "
readyLevel: db "1",0

gameOverText: incbin "game_over.bin"
    assert $-gameOverText=GAME_OVER_WIDTH*GAME_OVER_ROWS

    include "redefine_keys.a80"
    include "menu_logo_setup.a80"

menuLogoBitmap: incbin "gfx/blokius-logo.bin"
    assert $-menuLogoBitmap=8*MENU_LOGO_WIDTH*MENU_LOGO_ROWS
