; One game tick in Frame 1. Frame 2 tests the resulting positions and draws
; the same projectile list. The next tick consumes the collision results.
    include "motion_step.a80"

SHIP_LEFT equ 2             ; leave two dots against the left edge
PLAYER_RIGHT equ 59
PLAYER_BOTTOM equ 43
HIDDEN_BOX equ 96           ; outside the domain of every real projectile
WAVE_ENEMIES equ 3

gameInit:
    ld hl,playerArt
    ld (sprite08+SPRITE.IMAGE),hl
    ld hl,enemyArt
    dup WAVE_ENEMIES, slot
        ld (sprite09+slot*SPRITE+SPRITE.IMAGE),hl
    edup
    call resetEncounter
    jp syncActors

motionStep:
    call applyHits
    call readControls
    ifdef REPLAY_CONTROLS
        call readReplay
    endif
controlsReady:
    ld (lastControls),a
    ld e,a
    ld hl,restartHeld
    xor (hl)
    ld (hl),e
    and e
    and 32
    jp nz,restartGame
    ld a,(playerHealth)
    or a
    jr z,.moveEnemy
    call movePlayer
    call firePlayer
.moveEnemy:
    call stepWave
    MOVE_VOLLEYS
    MOVE_ENEMIES
    call spawnIncoming
    call syncActors
    ld hl,gameTick
    inc (hl)
gameplayComplete:
    ret

; Active input bits are P, O, Q, A, Space and Enter.
readControls:
    ld bc,#dffe
    in a,(c)
    cpl
    and 3
    ld e,a
    ld b,#fb
    in a,(c)
    rrca
    jr c,.upReleased
    set 2,e
.upReleased:
    ld b,#fd
    in a,(c)
    rrca
    jr c,.downReleased
    set 3,e
.downReleased:
    ld b,#7f
    in a,(c)
    rrca
    jr c,.fireReleased
    set 4,e
.fireReleased:
    ld b,#bf
    in a,(c)
    rrca
    jr c,.restartReleased
    set 5,e
.restartReleased:
    ld a,e
    ret

movePlayer:
    ld hl,(playerXY)
    ld a,e
    and 3
    jr z,.vertical
    cp 3
    jr z,.vertical
    rrca
    jr nc,.left
    ld a,l
    cp PLAYER_RIGHT
    jr z,.vertical
    inc l
    jr .vertical
.left:
    ld a,l
    cp SHIP_LEFT
    jr z,.vertical
    dec l
.vertical:
    ld a,e
    and 12
    cp 4
    jr nz,.down
    ld a,h
    or a
    jr z,.save
    dec h
    jr .save
.down:
    cp 8
    jr nz,.save
    ld a,h
    cp PLAYER_BOTTOM
    jr z,.save
    inc h
.save:
    ld (playerXY),hl
    ret

firePlayer:
    ld hl,fireWait
    ld a,(hl)
    or a
    jr z,.trigger
    dec (hl)
    ret
.trigger:
    bit 4,e
    ret z
    ld a,(playerXY)
    cp 58
    ret nc                      ; no room for both dots past the nose
    add a,4                      ; the mover advances one more dot this tick
    ld c,a
    ld a,(playerXY+1)
    add a,2
    ld d,a
    ld hl,volleys
    ld b,3
.find:
    ld a,(hl)
    inc a
    jr z,.spawn
    inc hl
    inc hl
    inc hl
    djnz .find
    ret                          ; keep old volleys until their slots are free
.spawn:
    ld (hl),c
    inc hl
    ld (hl),d
    inc hl
    ld (hl),#ff                 ; first MOVE_VOLLEYS increment starts age at 0
    ld a,8
    ld (fireWait),a
    ret

applyHits:
    ld hl,hitWait
    ld a,(hl)
    or a
    jr z,.checkPlayer
    dec (hl)
    ret
.checkPlayer:
    ld a,(player_hit)
    or a
    ret z
    ld hl,playerHealth
    ld a,(hl)
    or a
    ret z
    dec (hl)
    ld a,24
    ld (hitWait),a
    ret

stepWave:
    ld a,(enemiesAlive)
    or a
    jr z,.waiting
    ld a,(gameTick)
    and 3
    ld c,a
    ld ix,enemy_boxes
    ld de,collision_actual
    ld b,WAVE_ENEMIES
.next:
    ld a,(ix)
    cp HIDDEN_BOX
    jr z,.advance
    ld a,(de)
    or a
    jr z,.move
    ld hl,enemyKills
    inc (hl)
    jr .hide
.move:
    ld a,c
    or a
    jr nz,.advance
    dec (ix)
    ld a,(ix)
    cp 2
    jr nc,.advance
.hide:
    ld (ix),HIDDEN_BOX
    ld hl,enemiesAlive
    dec (hl)
    jr nz,.advance
    ld a,28
    ld (waveWait),a
.advance:
    inc ix
    inc ix
    inc de
    djnz .next
    ret
.waiting:
    ld hl,waveWait
    dec (hl)
    ret nz
    ld a,(waveIndex)
    inc a
    cp 3
    jr c,loadWave
    xor a

loadWave:
    ld (waveIndex),a
    add a,a
    ld e,a
    ld d,0
    ld hl,waveTable
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    ld a,(hl)
    ld (waveSlots),a
    ld (enemiesAlive),a
    inc hl
    ld a,(hl)
    ld (waveRate),a
    inc hl
    xor a
    ld (waveEmitter),a
    ld de,enemyPaths
    ld bc,WAVE_ENEMIES*2
    ldir
    ld de,enemy_boxes
    ld c,WAVE_ENEMIES*2
    ldir
    ret

spawnIncoming:
    ld a,(gameTick)
    ld c,a
    ld a,(waveRate)
    and c
    ret nz
    ld a,(waveEmitter)
    ld e,a
    ld d,0
    inc a
    ld hl,waveSlots
    cp (hl)
    jr c,.emitterReady
    xor a
.emitterReady:
    ld (waveEmitter),a
    ld hl,enemy_boxes
    add hl,de
    add hl,de
    ld a,(hl)
    cp HIDDEN_BOX
    ret z
    dec a
    ld b,a
    inc hl
    ld a,(hl)
    add a,2
    ld c,a
    ld hl,enemyPaths
    add hl,de
    add hl,de
    ld a,(gameTick)
    bit 2,a
    jr z,.pathReady
    inc hl
.pathReady:
    ld d,(hl)
    ld hl,(enemyWrite)
    ld a,(hl)
    inc a
    ret nz                       ; a full pool keeps its existing projectiles
    ld (hl),b
    inc hl
    ld (hl),c
    inc hl
    ld (hl),d
enemyShotEmitted:
    inc hl
    ld a,l
    cp low enemy_end
    jr nz,saveEnemyCursor
    ld hl,enemy_records
saveEnemyCursor:
    ld (enemyWrite),hl
    ret

syncActors:
    ld hl,(playerXY)
    ld a,(playerHealth)
    or a
    jr nz,.playerVisible
    ld l,HIDDEN_BOX
.playerVisible:
    ld (player_box),hl
    ld de,#0c0c                ; logical origin is 12 dots inside sprite buffer
    add hl,de
    ld (sprite08+SPRITE.X),hl
    ld (sprite08+SPRITE.DRAWX),hl
    dup WAVE_ENEMIES, slot
        ld hl,(enemy_boxes+slot*2)
        add hl,de
        ld (sprite09+slot*SPRITE+SPRITE.X),hl
        ld (sprite09+slot*SPRITE+SPRITE.DRAWX),hl
    edup
    ld a,(hitWait)
    or a
    jr z,.clearBorder
    ld a,2
.clearBorder:
    out (#fe),a
    ret

restartGame:
    call rewindBarrel
    call resetEncounter
    jp syncActors

resetEncounter:
    ld hl,initialPlayer
    ld de,playerXY
    ld bc,runEnd-playerXY
    ldir
    ld hl,initialPools
    ld de,volleys
    ld bc,enemy_end-volleys
    ldir
    xor a
    ld (player_hit),a
    ld (collision_actual+2),a
    ld h,a
    ld l,a
    ld (collision_actual),hl
    jp loadWave

rewindBarrel:
    xor a
    ld hl,tileMap
    ld de,tileMap+1
    ld bc,tileMapWidth*tileMapHeight-1
    ld (hl),a
    ldir
    ld h,a
    ld l,a
    ld (tileMapScroll),hl
    ld (sourceTileMapReadIndex),hl
    ld (tileMapWriteColumn),hl
    ld (tileMapWriteRow),hl
    ld hl,tileUpdateFrames
    ld (doNextTileFrame+1),hl
    ld hl,tileFrames
    ld (barrelScroll_AnimFrame1+1),hl
    ld hl,tileFrames2
    ld (barrelScroll_AnimFrame2+1),hl
    ld hl,tileFrames3
    ld (barrelScroll_AnimFrame3+1),hl
    ld hl,tileFrames4
    ld (barrelScroll_AnimFrame4+1),hl
    ld hl,tileFrames5
    ld (barrelScroll_AnimFrame5+1),hl
    ld hl,tileSet+3*48
    ld (tilesLUT+3*2),hl
    ld hl,tileSet+12*48
    ld (tilesLUT+12*2),hl
    ld hl,tileSet+13*48
    ld (tilesLUT+13*2),hl
    ld hl,tileSet+28*48
    ld (tilesLUT+28*2),hl
    ld hl,tileSet+29*48
    ld (tilesLUT+29*2),hl
    jp barrelScroll_Init

    MOTION_WRITE_SHOT

playerXY: dw 0
playerHealth: db 0
enemyKills: db 0
gameTick: db 0
hitWait: db 0
fireWait: db 0
waveWait: db 0
enemyWrite: dw 0
runEnd:
initialPlayer: db 8,21,3,0,0,0,0,0
    dw enemy_records
    assert $-initialPlayer=runEnd-playerXY

lastControls: db 0
restartHeld: db 0
waveIndex: db 0
waveSlots: db 0
enemiesAlive: db 0
waveRate: db 0
waveEmitter: db 0
enemyPaths: defs WAVE_ENEMIES*2
player_box: dw 0
enemy_boxes:
    dup 15 : db HIDDEN_BOX,0 : edup

; Enemy count, tick mask, two initial path indices per ship, then positions.
; The path indices select entries in the shared eight-step trajectory table.
waveTable: dw streamWave, crossingWave, fanWave
streamWave: db 1,0, 0,0, 0,0, 0,0, 52,21, HIDDEN_BOX,0, HIDDEN_BOX,0
crossingWave: db 2,1, 16,16, 8,8, 0,0, 54,12, 57,31, HIDDEN_BOX,0
fanWave: db 3,0, 24,16, 40,48, 32,8, 52,15, 57,23, 59,33

volleys:
    defs 3*3
player_shots:
    defs 9*2
player_positions equ player_shots
enemy_records:
    defs ENEMY_COUNT*3
enemy_end:
enemy_positions equ enemy_records
initialPools:
    dup 3 : db #ff,0,0 : edup
    dup 9 : db #ff,0 : edup
    dup ENEMY_COUNT : db #ff,0,0 : edup

    align 256
trajectories: incbin "trajectories.bin"
playerArt: incbin "player_art.bin"
enemyArt: incbin "enemy_art.bin"

    ifdef REPLAY_CONTROLS
readReplay:
    ld hl,replayLeft
    ld a,(hl)
    or a
    jr nz,.repeat
    ld de,(replayCursor)
    ld a,(de)
    or a
    ret z
    ld (hl),a
    inc de
    ld a,(de)
    inc de
    ld (replayCursor),de
    ld (replayMask),a
.repeat:
    dec (hl)
    ld a,(replayMask)
    ret

replayLeft: db 0
replayMask: db 0
replayCursor: dw replayControls
replayControls: incbin "controls.bin"
    endif
