; One game tick in Frame 1. Frame 2 tests the resulting positions and draws
; the same projectile list. The next tick consumes the collision results.
SHIP_LEFT equ 2             ; leave two dots against the left edge
PLAYER_RIGHT equ 59
PLAYER_BOTTOM equ 43
HIDDEN_BOX equ 96           ; outside the domain of every real projectile
WAVE_ENEMIES equ 12
EXPLOSION_TICKS equ 6
PLAYER_PAIRS equ 5
PLAYER_PAIR_GAP equ 4
PROJECTILE_POOL_BYTES equ PLAYER_PAIRS*2+ENEMY_COUNT*3
PLAYER_START equ 8+21*256
STARTING_LIVES equ 3
RESPAWN_TICKS equ 12          ; brief gap before a replacement ship appears
INVINCIBLE_TICKS equ 75       ; three seconds at the 25 Hz game rate

gameInit:
    call resetEncounter
    call hudInit
    jp syncActors

scrollScenery:
    ld a,(gameTick)
    rrca
    ret c
    call barrelScroll_DoAnimations
    ld a,(barrelScrollComplete)
    or a
    ret nz
    call barrelScroll_UpdateDoNextTile
    jp barrelScroll_UpdateAdvanceScroll

motionStep:
    call updatePlayerLife
    call readControls
    ifdef REPLAY_CONTROLS
        call readReplay
    endif
controlsReady:
    ld (lastControls),a
    ld e,a
    ld hl,restartHeld
    xor (hl)
    ld (hl),e
    and e
    and 32
    jp nz,restartGame
    ld a,(playerLives)
    or a
    jr z,.moveEnemy
    ld a,(respawnWait)
    or a
    jr nz,.moveEnemy
    ld a,(invincibleTicks)
    cp INVINCIBLE_TICKS
    jr z,.moveEnemy             ; present the new ship at its spawn point first
    call movePlayer
    call firePlayer
.moveEnemy:
    call stepWave
    call movePlayerPairs
    call moveIncoming
    call spawnIncoming
    call syncActors
    ld hl,gameTick
    inc (hl)
gameplayComplete:
    ret

; Active input bits are P, O, Q, A, Space and Enter.
readControls:
    ld bc,#dffe
    in a,(c)
    cpl
    and 3
    ld e,a
    ld b,#fb
    in a,(c)
    rrca
    jr c,.upReleased
    set 2,e
.upReleased:
    ld b,#fd
    in a,(c)
    rrca
    jr c,.downReleased
    set 3,e
.downReleased:
    ld b,#7f
    in a,(c)
    rrca
    jr c,.fireReleased
    set 4,e
.fireReleased:
    ld b,#bf
    in a,(c)
    rrca
    jr c,.restartReleased
    set 5,e
.restartReleased:
    ld a,e
    ret

movePlayer:
    ld hl,(playerXY)
    ld a,e
    and 3
    jr z,.vertical
    cp 3
    jr z,.vertical
    rrca
    jr nc,.left
    ld a,l
    cp PLAYER_RIGHT
    jr z,.vertical
    inc l
    jr .vertical
.left:
    ld a,l
    cp SHIP_LEFT
    jr z,.vertical
    dec l
.vertical:
    ld a,e
    and 12
    cp 4
    jr nz,.down
    ld a,h
    or a
    jr z,.save
    dec h
    jr .save
.down:
    cp 8
    jr nz,.save
    ld a,h
    cp PLAYER_BOTTOM
    jr z,.save
    inc h
.save:
    ld (playerXY),hl
    ret

firePlayer:
    ld hl,fireWait
    ld a,(hl)
    or a
    jr z,.trigger
    dec (hl)
    ret
.trigger:
    bit 4,e
    ret z
    ld a,(playerXY)
    cp 58
    ret nc                      ; no room for both dots past the nose
    add a,2                      ; the three-dot step starts the pair at the nose
    ld c,a
    ld a,(playerXY+1)
    ld d,a
    ld hl,player_pairs
    ld b,PLAYER_PAIRS
.find:
    ld a,(hl)
    inc a
    jr z,.spawn
    inc hl
    inc hl
    djnz .find
    ret                          ; keep existing pairs until their slots are free
.spawn:
    ld (hl),c
    inc hl
    ld (hl),d
    ifdef LIVE_SFX
        call startShotSound
    endif
    ld a,3                      ; four game ticks between launches
    ld (fireWait),a
    ret

movePlayerPairs:
    dup PLAYER_PAIRS, slot
        ld hl,player_pairs+slot*2
        ld a,(hl)
        inc a
        jr z,1f
        add a,2
        cp 63
        jr c,2f
        ld a,#ff
2:
        ld (hl),a
1:
    edup
    ret

expandPlayerPairs:
    ; Collision has already retired any spent pair before plotting.
    dup PLAYER_PAIRS, slot
        ld hl,(player_pairs+slot*2)
        ld (player_shots+slot*4),hl
        dup PLAYER_PAIR_GAP : inc h : edup
        ld (player_shots+slot*4+2),hl
    edup
    ret

updatePlayerLife:
    ld hl,playerExplosion
    ld a,(hl)
    or a
    jr z,.life
    dec (hl)
.life:
    ld a,(playerLives)
    or a
    ret z
    ld hl,respawnWait
    ld a,(hl)
    or a
    jr nz,.respawn
    ld hl,invincibleTicks
    ld a,(hl)
    or a
    jr z,.checkPlayer
    dec (hl)                    ; discard the overlap from the previous protected frame
    ret
.checkPlayer:
    ld a,(player_hit)
    or a
    ret z
    ld hl,playerLives
    dec (hl)
    ld hl,playerExplosion
    ld (hl),EXPLOSION_TICKS
    ld hl,hudPending
    set HUD_LIVES_DIRTY,(hl)     ; SET preserves the zero flag from DEC
    ret z                       ; game over
    ld a,RESPAWN_TICKS
    ld (respawnWait),a
    ret
.respawn:
    dec (hl)
    ret nz
    ld hl,PLAYER_START
    ld (playerXY),hl
    xor a
    ld (fireWait),a
    ld a,INVINCIBLE_TICKS
    ld (invincibleTicks),a
    ret

syncActors:
    ld a,(playerExplosion)
    or a
    jr z,.normalShip
    call explosionArt
    ld (sprite08+SPRITE.IMAGE),hl
    ld hl,(playerXY)
    ld a,l
    ld l,HIDDEN_BOX
    ld (player_box),hl
    ld l,a
    jr .shipPosition
.normalShip:
    ld hl,playerArt
    ld (sprite08+SPRITE.IMAGE),hl
    ld hl,(playerXY)
    ld a,(playerLives)
    or a
    jr z,.shipAbsent
    ld a,(respawnWait)
    or a
    jr nz,.shipAbsent
    ld (player_box),hl          ; blinking changes the draw position only
    ld a,(invincibleTicks)
    or a
    jr z,.shipPosition
    rrca
    jr c,.shipPosition         ; visible on odd protected frames
    ld l,HIDDEN_BOX
    jr .shipPosition
.shipAbsent:
    ld l,HIDDEN_BOX
    ld (player_box),hl
.shipPosition:
    ld de,#0c0c                ; logical origin is 12 dots inside sprite buffer
    add hl,de
    ld (sprite08+SPRITE.X),hl
    jp syncEnemyShips

restartGame:
    call rewindBarrel
    call resetEncounter
    jp syncActors

resetEncounter:
    ld a,(playerLives)
    cp STARTING_LIVES
    jr z,.livesReady
    ld hl,hudPending
    set HUD_LIVES_DIRTY,(hl)
.livesReady:
    ld hl,initialPlayer
    ld de,playerXY
    ld bc,runEnd-playerXY
    ldir
    ld hl,initialPools
    ld de,player_pairs
    dup PROJECTILE_POOL_BYTES : ldi : edup
    ld hl,initialShips
    ld de,enemy_boxes
    ld bc,2*(15+WAVE_ENEMIES)
    dup 2*(15+WAVE_ENEMIES) : ldi : edup
    ld hl,enemyArt
    dup WAVE_ENEMIES, slot
        ld (sprite09+slot*SPRITE+SPRITE.IMAGE),hl
    edup
    xor a
    ld (player_hit),a
    ld (collision_actual+2),a
    ld h,a
    ld l,a
    ld (collision_actual),hl
    ld de,(hudScore)
    ld a,d
    or e
    jr z,.scoreReady
    ld (hudScore),hl
    ld hl,hudPending
    set HUD_SCORE_DIRTY,(hl)
.scoreReady:
    xor a
    ld (waveIndex),a
    ld (fireSlot),a
    ld (spreadWait),a
    ld (spawnSlot),a
    ifdef LIVE_SFX
        jp resetSoundEffects
    else
        ret
    endif

    include "score_hud.a80"
    include "game_over_hud.a80"

rewindBarrel:
    xor a
    ld h,a
    ld l,a
    ; Keep the complete rewind inside Frame 1, including when the HUD is busy.
    assert tileMapWidth*tileMapHeight % 2 = 0
    dup tileMapWidth*tileMapHeight/2, word
        ld (tileMap+word*2),hl
    edup
    ld (tileMapScroll),hl
    ld (sourceTileMapReadIndex),hl
    ld (tileMapWriteColumn),hl
    ld (tileMapWriteRow),hl
    ld hl,tileUpdateFrames
    ld (doNextTileFrame+1),hl
    ld hl,tileFrames
    ld (barrelScroll_AnimFrame1+1),hl
    ld hl,tileFrames2
    ld (barrelScroll_AnimFrame2+1),hl
    ld hl,tileFrames3
    ld (barrelScroll_AnimFrame3+1),hl
    ld hl,tileFrames4
    ld (barrelScroll_AnimFrame4+1),hl
    ld hl,tileFrames5
    ld (barrelScroll_AnimFrame5+1),hl
    ld hl,tileSet+3*48
    ld (tilesLUT+3*2),hl
    ld hl,tileSet+12*48
    ld (tilesLUT+12*2),hl
    ld hl,tileSet+13*48
    ld (tilesLUT+13*2),hl
    ld hl,tileSet+28*48
    ld (tilesLUT+28*2),hl
    ld hl,tileSet+29*48
    ld (tilesLUT+29*2),hl
    jp barrelScroll_Init

playerXY: dw 0
playerLives: db STARTING_LIVES
enemyKills: db 0
gameTick: db 0
respawnWait: db 0
invincibleTicks: db 0
fireWait: db 0
spawnWait: db 0
waveRemaining: db 0
playerExplosion: db 0
enemyWrite: dw 0
runEnd:
initialPlayer:
    dw PLAYER_START
    db STARTING_LIVES,0,0,0,0,0,0,WAVE_ENEMIES,0
    dw enemy_records
    assert $-initialPlayer=runEnd-playerXY

lastControls: db 0
restartHeld: db 0
waveIndex: db 0
fireSlot: db 0
spreadWait: db 0
spawnSlot: db 0
player_box: dw 0
enemy_boxes: defs 15*2
enemyMotion: defs WAVE_ENEMIES*2
initialShips:
    dup 15 : db HIDDEN_BOX,0 : edup
    defs WAVE_ENEMIES*2

player_pairs:
    defs PLAYER_PAIRS*2
enemy_records:
    defs ENEMY_COUNT*3
enemy_end:
    assert enemy_end-player_pairs=PROJECTILE_POOL_BYTES
enemy_positions equ enemy_records
player_shots:
    defs PLAYER_PAIRS*4
player_positions equ player_shots
initialPools:
    dup PLAYER_PAIRS : db #ff,0 : edup
    dup ENEMY_COUNT : db #ff,0,0 : edup

    ifdef REPLAY_CONTROLS
readReplay:
    ld hl,replayLeft
    ld a,(hl)
    or a
    jr nz,.repeat
    ld de,(replayCursor)
    ld a,(de)
    or a
    ret z
    ld (hl),a
    inc de
    ld a,(de)
    inc de
    ld (replayCursor),de
    ld (replayMask),a
.repeat:
    dec (hl)
    ld a,(replayMask)
    ret

replayLeft: db 0
replayMask: db 0
replayCursor: dw replayControls
replayControls: incbin "controls.bin"
    endif
