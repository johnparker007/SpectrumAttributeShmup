YELLOW_APPROACH equ #80
YELLOW_BACKUP equ #81
YELLOW_RETREAT_TICKS equ 12
YELLOW_EXIT equ #c0
YELLOW_TURN_X equ 26
YELLOW_WAVE_SIZE equ 6

; Set both the trajectory and art because slots can change wave type.
spawnLevelShip:
    ld a,(waveKind)
    or a
    jr nz,.yellow
    ld a,(waveIndex)
    ld (ix),a
    or 3                         ; spawn X=67 indexes sample 3
    ld e,a
    ld d,high shipTrajectories
    ld a,(de)
    ld (hl),a
    ld bc,enemyArt
    jr .art
.yellow:
    ld a,(waveRemaining)
    dec a
    ld e,a
    ld d,0
    push hl
    ld hl,yellowEntryRows
    add hl,de
    ld a,(hl)
    pop hl
    ld (ix),YELLOW_APPROACH
    ld (hl),a
    ld a,(waveIndex)
    or a
    jr nz,.yellowArt
    ld a,PLAYER_BOTTOM
    sub (hl)
    ld (hl),a
.yellowArt:
    ld bc,yellowArt
.art:
    push hl
    ld a,(spawnSlot)
    ld e,a
    ld d,0
    add a,a
    add a,a
    add a,a
    add a,e
    assert SPRITE=9
    ld e,a
    ld hl,sprite09+SPRITE.IMAGE
    add hl,de
    ld (hl),c
    inc hl
    ld (hl),b
    pop hl
    ret

advanceLevelWave:
    ld a,(waveKind)
    or a
    jr nz,.afterYellow
    ld a,(waveIndex)
    xor #40                      ; alternate the green wave's entrance
    ld (waveIndex),a
    ld a,(yellowFireMode)
    inc a
    jr z,.greenOnly
    ld (hl),YELLOW_WAVE_SIZE
    ld a,1
    ld (waveKind),a
    ld a,(levelWaveGaps)
    jr .saveGap
.greenOnly:
    ld (hl),WAVE_ENEMIES
    ret
.afterYellow:
    ld (hl),WAVE_ENEMIES
    xor a
    ld (waveKind),a
    ld a,(levelWaveGaps+1)
.saveGap:
    ld (spawnWait),a
    ret

; A is the movement state. HL enters on X and returns on Y.
moveYellow:
    cp YELLOW_BACKUP
    jr c,.approach
    cp YELLOW_EXIT
    jr nc,.exit
    push af
    inc (hl)
    inc (hl)
    inc hl
    exx
    push hl
    ld hl,yellowRetreatPaths-enemyMotion
    add hl,de
    ld c,(hl)
    inc hl
    ld b,(hl)
    ld a,(bc)
    inc bc
    ld (hl),b
    dec hl
    ld (hl),c
    pop hl
    exx
    add a,(hl)
    ld (hl),a
    pop af
    cp YELLOW_BACKUP+YELLOW_RETREAT_TICKS-1
    jr z,.endRetreat
    inc a
    call .state
    cp YELLOW_BACKUP+YELLOW_RETREAT_TICKS/2
    ret nz
    ld a,(yellowFireMode)
    cp 2
    ret nz
    jr .queue
.endRetreat:
    ld a,YELLOW_EXIT
    call .state
    ld a,(yellowFireMode)
    or a
    ret z
.queue:
    ld a,(hl)
    add a,2
    ld (yellowShot+1),a
    dec hl
    ld a,(hl)
.shotQueued:
    ld (yellowShot),a
    inc hl
    ret
.approach:
    dec (hl)
    ld a,(hl)
    cp YELLOW_TURN_X
    jr nz,.still
    ld a,(playerXY+1)
.targetLocked:
    inc hl
    sub (hl)
    dec hl
    add a,PLAYER_BOTTOM
    ; Select one twelve-step path for the signed Y difference.
    exx
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld b,h
    ld c,l
    add hl,hl
    add hl,bc
    ld bc,yellowRetreatSteps
    add hl,bc
    ld b,h
    ld c,l
    ld hl,yellowRetreatPaths-enemyMotion
    add hl,de
    ld (hl),c
    inc hl
    ld (hl),b
    pop hl
    exx
    ld a,YELLOW_BACKUP
    call .state
.still:
    inc hl
    ret
.exit:
    dec (hl)
    ld a,(hl)
    cp #fb
    jr nz,.still
    ld (hl),HIDDEN_BOX
    jr .still
.state:
    exx
    ld (de),a
    exx
    ret

emitYellowShot:
    ld hl,(yellowShot)
    ld a,l
    inc a
    ret z
    ld a,#ff
    ld (yellowShot),a
    ld b,l
    ld c,h
    jp aimQueuedShot

; Indexed by remaining ships, so the first entrance uses the last row here.
yellowEntryRows: db 28,19,39,15,35,8
yellowRetreatPaths: defs 2*WAVE_ENEMIES
yellowRetreatSteps:
    incbin "yellow_retreat.bin"
    assert $-yellowRetreatSteps=(2*PLAYER_BOTTOM+1)*YELLOW_RETREAT_TICKS
waveKind: db 0
levelWaveGaps: dw 0
yellowFireMode: db #ff
yellowShot: dw #ff
