YELLOW_APPROACH equ #80
YELLOW_BACKUP equ #81
YELLOW_RETREAT_TICKS equ 12
YELLOW_EXIT equ #c0
YELLOW_TURN_X equ 26
YELLOW_Y_STEP equ 4

; Four yellow slots in a twelve-ship formation. The other slots keep the sine.
setSpawnArt:
    ld a,(yellowFireMode)
    inc a
    ret z
    ld a,(spawnSlot)
    ld e,a
    ld d,0
    push hl
    ld hl,yellowEntryRows
    add hl,de
    ld a,(hl)
    pop hl
    or a
    ret m
    ld (ix),YELLOW_APPROACH
    ld (hl),a
    ld a,(waveIndex)
    or a
    jr z,.art
    ld a,PLAYER_BOTTOM
    sub (hl)
    ld (hl),a
.art:
    push hl
    ld a,e
    add a,a
    add a,a
    add a,a
    add a,e
    assert SPRITE=9
    ld e,a
    ld hl,sprite09+SPRITE.IMAGE
    add hl,de
    ld (hl),low yellowArt
    inc hl
    ld (hl),high yellowArt
    pop hl
    ret

; A is the movement state. HL enters on X and returns on Y.
moveYellow:
    cp YELLOW_BACKUP
    jr c,.approach
    cp YELLOW_EXIT
    jr nc,.exit
    push af
    inc (hl)
    inc hl
    ld a,(playerXY+1)
    sub (hl)
    jr c,.up
    cp YELLOW_Y_STEP+1
    jr c,.shift
    ld a,YELLOW_Y_STEP
    jr .shift
.up:
    cp -YELLOW_Y_STEP
    jr nc,.shift
    ld a,-YELLOW_Y_STEP
.shift:
    add a,(hl)
    ld (hl),a
    pop af
    cp YELLOW_BACKUP+YELLOW_RETREAT_TICKS-1
    jr z,.endRetreat
    inc a
    call .state
    cp YELLOW_BACKUP+YELLOW_RETREAT_TICKS/2
    ret nz
    ld a,(yellowFireMode)
    cp 2
    ret nz
    jr .queue
.endRetreat:
    ld a,YELLOW_EXIT
    call .state
    ld a,(yellowFireMode)
    or a
    ret z
.queue:
    ld a,(hl)
    add a,2
    ld (yellowShot+1),a
    dec hl
    ld a,(hl)
.shotQueued:
    ld (yellowShot),a
    inc hl
    ret
.approach:
    bit 0,c
    jr nz,.still
    dec (hl)
    ld a,(hl)
    cp YELLOW_TURN_X
    jr nz,.still
    ld a,YELLOW_BACKUP
    call .state
.still:
    inc hl
    ret
.exit:
    bit 0,c
    jr nz,.still
    dec (hl)
    ld a,(hl)
    cp #fb
    jr nz,.still
    ld (hl),HIDDEN_BOX
    jr .still
.state:
    exx
    ld (de),a
    exx
    ret

emitYellowShot:
    ld hl,(yellowShot)
    ld a,l
    inc a
    ret z
    ld a,#ff
    ld (yellowShot),a
    ld b,l
    ld c,h
    jp aimQueuedShot

yellowEntryRows: db 255,255,8,255,255,35,255,255,15,255,255,28
yellowFireMode: db #ff
yellowShot: dw #ff
