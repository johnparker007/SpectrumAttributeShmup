MENU_LOGO_WIDTH equ 28
MENU_LOGO_ROWS equ 4
MENU_LOGO_LEFT equ (32-MENU_LOGO_WIDTH)/2
    ifdef LUMINANCE_LOGO
MENU_LOGO_TOP equ 2
    else
MENU_LOGO_TOP equ 1
    endif
MENU_LOGO_PIXELS equ #4000+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_ATTRS equ #5800+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_PAIRS equ MENU_LOGO_WIDTH/2
MENU_LOGO_LATE_PAIRS equ 9
MENU_LOGO_EARLY_PAIRS equ MENU_LOGO_PAIRS-MENU_LOGO_LATE_PAIRS
    ifdef LUMINANCE_LOGO
    include "gfx/luminance-layout.a80"
    else
MENU_LOGO_PHASES equ 512
    endif
MENU_LOGO_EARLY_X equ MENU_LOGO_WIDTH-2
MENU_LOGO_LATE_X equ 2*MENU_LOGO_LATE_PAIRS-2

drawMenuLogo:
    ld hl,menuLogoBitmap
    ld de,MENU_LOGO_PIXELS
    ld a,8
.scanline:
    ld ixl,MENU_LOGO_ROWS
.row:
    ld bc,MENU_LOGO_WIDTH
    ldir
    dup 32-MENU_LOGO_WIDTH
        inc de
    edup
    dec ixl
    jr nz,.row
    ld e,low MENU_LOGO_PIXELS
    inc d
    dec a
    jr nz,.scanline
    ld hl,0
    ld (menuLogoPhase),hl
    ifdef LUMINANCE_LOGO
        ld a,#ff
        dup 2, bar
            dup 2, stripe
                ; The normal screen supplies the red lines at 0 and 4.
                ld hl,#4020+bar*6*32+stripe*#400
                ld (hl),a
                ld d,h
                ld e,l
                inc de
                ld bc,31
                ldir
            edup
        edup
        ld a,#02
        dup 2, bar
            ld hl,#5820+bar*6*32
            ld (hl),a
            ld d,h
            ld e,l
            inc de
            ld bc,31
            ldir
        edup
        ld a,7
        call swapPage
        dup 2, bar
            dup 4, stripe
                if stripe=0
                    ld hl,#d820+bar*6*32
                    ld a,#3e     ; Normal yellow ink and normal white paper.
                else
                    ld hl,#c020+bar*6*32+stripe*#100
                    ld a,#ff
                    if stripe=2
                        xor a
                    endif
                endif
                ld (hl),a
                ld d,h
                ld e,l
                inc de
                ld bc,31
                ldir
            edup
        edup
        xor a
        call swapPage
        jp initMenuCopper
    else
    ret
    endif

    ifndef LUMINANCE_LOGO
; Map strip position (phase + BC) to a right-to-left run of PUSH opcodes.
menuLogoPatternStart:
    ld hl,(menuLogoPhase)
    add hl,bc
    srl h : rr l
    ld a,0
    rla : add a,a
    add a,high menuLogoPushPatterns
    ld h,a
    xor a : sub l
    ld l,a
    ret

; Each pair of raster lines advances one source byte in the circular page.
; LDI walks forwards through the reversed strip while PUSH paints right to left.
    macro PATCH_MENU_LOGO_RUN dest,offset,pairs,stride,lines,step
        ld bc,offset
        call menuLogoPatternStart
        ld de,dest
        ld ixl,lines/2
.row:
        dup 2
            push hl
            dup pairs
                ldi
            edup
            pop hl
            dup step
                dec l
            edup
            ex de,hl
            ld bc,stride-pairs
            add hl,bc
            ex de,hl
        edup
        dec ixl
        jr nz,.row
    endm

patchMenuLogoRows:
    ld a,(menuLogoPhase)
    and 1
    add a,a : add a,a : add a,a
    ld e,a : ld d,0
    ld hl,menuLogoInkPairs
    add hl,de
    ld (menuLogoOtherPalette+1),hl
    ld de,8
    add hl,de
    ld de,menuLogoPalette
    ld bc,8
    ldir
    ; The five rightmost pairs beat the beam. The left nine update the next line.
    PATCH_MENU_LOGO_RUN menuLogoEarlyWrites,MENU_LOGO_EARLY_X,MENU_LOGO_EARLY_PAIRS,2*MENU_LOGO_LINE_BYTES,16,1
menuLogoEarlyOdd:
    PATCH_MENU_LOGO_RUN menuLogoEarlyWrites+MENU_LOGO_LINE_BYTES,MENU_LOGO_EARLY_X+1,MENU_LOGO_EARLY_PAIRS,2*MENU_LOGO_LINE_BYTES,16,1
menuLogoLateEven:
    PATCH_MENU_LOGO_RUN menuLogoLateWrites,MENU_LOGO_LATE_X+1,MENU_LOGO_LATE_PAIRS,2*MENU_LOGO_LINE_BYTES,16,1
menuLogoLateOdd:
    PATCH_MENU_LOGO_RUN menuLogoLateWrites+MENU_LOGO_LINE_BYTES,MENU_LOGO_LATE_X+2,MENU_LOGO_LATE_PAIRS,2*MENU_LOGO_LINE_BYTES,16,1
menuLogoPatchSeed:
    PATCH_MENU_LOGO_RUN menuLogoSeedCode+3,MENU_LOGO_LATE_X,MENU_LOGO_LATE_PAIRS,3+MENU_LOGO_LATE_PAIRS,MENU_LOGO_ROWS,4
    ret

; Seed the first scanline of each physical attribute row before the beam.
seedMenuLogoRows:
    ld (menuLogoSeedStack+1),sp
menuLogoOtherPalette:
    ld sp,0
    pop bc : pop de : pop hl : pop af
    exx : ex af,af'
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af
menuLogoSeedCode:
    dup MENU_LOGO_ROWS, row
        ld sp,MENU_LOGO_ATTRS+2*MENU_LOGO_LATE_PAIRS+32*row
        dup MENU_LOGO_LATE_PAIRS
            push bc
        edup
    edup
menuLogoSeedStack:
    ld sp,0
    ret

advanceMenuLogoPhase:
    ld hl,(menuLogoPhase)
    inc hl
    res 1,h
    ld (menuLogoPhase),hl
    ret

menuLogoPhase: dw 0
; Opposite parity first, then the parity needed for scanline zero.
menuLogoInkPairs:
    incbin "gfx/blokius-logo-raster.bin",0,24
    align 256
menuLogoPushPatterns: incbin "gfx/blokius-logo-raster.bin",24
    assert $-menuLogoPushPatterns=2*MENU_LOGO_PHASES
    endif

    ifdef LUMINANCE_LOGO
menuCopper128Source:
    include "gfx/copper-128k.a80"
menuGold128Source:
    include "gfx/gold-128k.a80"
menuCopper128SourceEnd:
menuCopperPlusSource:
    include "gfx/copper-plus.a80"
menuGoldPlusSource:
    include "gfx/gold-plus.a80"
menuCopperPlusSourceEnd:
    endif
