MENU_LOGO_WIDTH equ 28
MENU_LOGO_ROWS equ 4
MENU_LOGO_LEFT equ (32-MENU_LOGO_WIDTH)/2
MENU_LOGO_TOP equ 1
MENU_LOGO_PIXELS equ #4000+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_ATTRS equ #5800+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_PAIRS equ MENU_LOGO_WIDTH/2
MENU_LOGO_LATE_PAIRS equ 9
MENU_LOGO_EARLY_PAIRS equ MENU_LOGO_PAIRS-MENU_LOGO_LATE_PAIRS
MENU_LOGO_PHASES equ 128

    macro WRAP_MENU_LOGO_PATTERNS
        ld a,h
        sub iyl
        and 3
        add a,iyl
        ld h,a
    endm

drawMenuLogo:
    ld hl,menuLogoBitmap
    ld de,MENU_LOGO_PIXELS
    ld a,8
.scanline:
    ld ixl,MENU_LOGO_ROWS
.row:
    ld bc,MENU_LOGO_WIDTH
    ldir
    dup 32-MENU_LOGO_WIDTH
        inc de
    edup
    dec ixl
    jr nz,.row
    ld e,low MENU_LOGO_PIXELS
    inc d
    dec a
    jr nz,.scanline
    xor a
    ld (menuLogoClock),a
    ld (menuLogoPhase),a
    ret

; Each four-page ring contains one parity of the moving pattern. A 16-byte
; step advances one scanline along the ring.
patchMenuLogoRows:
    ld a,(menuLogoPhase)
    and 1
    add a,a : add a,a
    add a,high menuLogoPushPatterns
    ld iyl,a
    ld a,(menuLogoPhase)
    and #60
    rlca : rlca : rlca
    add a,iyl
    ld h,a
    ld a,(menuLogoPhase)
    and #1e
    add a,a : add a,a : add a,a
    ld l,a
    push hl
    ld de,menuLogoRaster+3
    ld ixl,8*MENU_LOGO_ROWS
.rasterRow:
    dup MENU_LOGO_PAIRS
        ldi
    edup
    inc hl : inc hl
    WRAP_MENU_LOGO_PATTERNS
    ; Skip the end-of-line padding and the next LD SP instruction.
    ex de,hl
    ld bc,7
    add hl,bc
    ex de,hl
    dec ixl
    jr nz,.rasterRow

    pop hl
    ld bc,MENU_LOGO_EARLY_PAIRS-16
    add hl,bc
    WRAP_MENU_LOGO_PATTERNS
    ld de,menuLogoSeedCode+3
    ld ixl,MENU_LOGO_ROWS
.seedRow:
    ; Take the previous line's late writes, which target this new row.
    dup MENU_LOGO_LATE_PAIRS
        ldi
    edup
    ld bc,8*16-MENU_LOGO_LATE_PAIRS
    add hl,bc
    WRAP_MENU_LOGO_PATTERNS
    inc de : inc de : inc de
    dec ixl
    jr nz,.seedRow
    ret

; Seed the first scanline of each physical attribute row before the beam.
seedMenuLogoRows:
    ld (menuLogoSeedStack+1),sp
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af
menuLogoSeedCode:
    dup MENU_LOGO_ROWS, row
        ld sp,MENU_LOGO_ATTRS+2*MENU_LOGO_LATE_PAIRS+32*row
        dup MENU_LOGO_LATE_PAIRS
            push bc
        edup
    edup
menuLogoSeedStack:
    ld sp,0
    ret

advanceMenuLogoPhase:
    ld hl,menuLogoClock
    inc (hl)
    ld a,(hl)
    and 3
    ret nz
    ld a,(menuLogoPhase)
    inc a
    and MENU_LOGO_PHASES-1
    ld (menuLogoPhase),a
    ret

menuLogoClock: db 0
menuLogoPhase: db 0
    align 256
menuLogoPushPatterns: incbin "gfx/blokius-logo-raster.bin"
    assert $-menuLogoPushPatterns=16*MENU_LOGO_PHASES
