MENU_LOGO_WIDTH equ 28
MENU_LOGO_ROWS equ 4
MENU_LOGO_LEFT equ (32-MENU_LOGO_WIDTH)/2
MENU_LOGO_TOP equ 1
MENU_LOGO_PIXELS equ #4000+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_ATTRS equ #5800+32*MENU_LOGO_TOP+MENU_LOGO_LEFT
MENU_LOGO_PAIRS equ MENU_LOGO_WIDTH/2
MENU_LOGO_LATE_PAIRS equ 9
MENU_LOGO_PAIR_BYTES equ 8

; PUSH paints from right to left. The ULA has already fetched the first
; nine pairs when their writes arrive, so those writes target the next line.
    macro MENU_LOGO_PUSH px,py
        ; PUSH BC, DE, HL and AF are spaced by #10.
        db #c5+16*((3*(py)+2*(px)+(py)*(px)/13+(px)*(px)/9+(py)*(py)/20)/5%4)
    endm

    macro MENU_LOGO_LINE scan_y,race_on
        ld sp,MENU_LOGO_ATTRS+MENU_LOGO_WIDTH+32*((scan_y)/8)
        dup MENU_LOGO_PAIRS, word
            if race_on && MENU_LOGO_PAIRS-1-word<MENU_LOGO_LATE_PAIRS
                MENU_LOGO_PUSH MENU_LOGO_PAIRS-1-word,(scan_y)+1
            else
                MENU_LOGO_PUSH MENU_LOGO_PAIRS-1-word,(scan_y)
            endif
        edup
    endm

drawMenuLogo:
    ld hl,menuLogoBitmap
    ld de,MENU_LOGO_PIXELS
    ld a,8
.scanline:
    ld ixl,MENU_LOGO_ROWS
.row:
    ld bc,MENU_LOGO_WIDTH
    ldir
    dup 32-MENU_LOGO_WIDTH
        inc de
    edup
    dec ixl
    jr nz,.row
    ld e,low MENU_LOGO_PIXELS
    inc d
    dec a
    jr nz,.scanline
    xor a
    ld (menuLogoClock),a
    ld (menuLogoPhase),a
    jr loadMenuLogoPalette

; Seed the first scanline of each physical attribute row before the beam.
seedMenuLogoRows:
    ld (.restoreStack+1),sp
    ld sp,menuLogoPalette
    pop bc : pop de : pop hl : pop af
    dup MENU_LOGO_ROWS, row
        MENU_LOGO_LINE row*8,0
    edup
.restoreStack:
    ld sp,0
    ret

advanceMenuLogoPalette:
    ld hl,menuLogoClock
    inc (hl)
    ld a,(hl)
    and 3
    ret nz
    ld hl,menuLogoPhase
    inc (hl)
    ld a,(hl)
loadMenuLogoPalette:
    ld l,a
    ld h,0
    add hl,hl : add hl,hl : add hl,hl
    ld de,menuLogoPalettes
    add hl,de
    ld de,menuLogoPalette
    ld bc,MENU_LOGO_PAIR_BYTES
    ldir
    ret

menuLogoClock: db 0
menuLogoPhase: db 0
menuLogoPalettes: incbin "gfx/blokius-logo-palettes.bin"
    assert $-menuLogoPalettes=256*MENU_LOGO_PAIR_BYTES
