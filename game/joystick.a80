; Translate both interfaces into the same Right, Left, Up, Down, Fire bits.
readKempston:
    in a,(#1f)
    and #1f
    ld hl,kempstonButtons
    jr readJoystickButtons

; Sinclair player 1 uses the active-low 6, 7, 8, 9 and 0 keyboard lines.
readSinclair:
    ld bc,#effe
    in a,(c)
    cpl
    and #1f
    ld hl,sinclairButtons
readJoystickButtons:
    ld e,a
    ld d,0
    add hl,de
    ld e,(hl)
    ld c,#fe
    jp readRestartControl

kempstonButtons:
    dup 32, buttons
        db (buttons & #13) | ((buttons & #04)<<1) | ((buttons & #08)>>1)
    edup
sinclairButtons:
    dup 32, buttons
        db ((buttons & #18)>>3) | ((buttons & #06)<<1) | ((buttons & 1)<<4)
    edup

; The menu rewrites the reader body in this area. Six independent
; reads are the longest possible body.
    macro READ_BOUND_KEY row,mask
        ld a,row
        in a,(#fe)
        and mask
        sub 1
        rl e
    endm

readCustomControls:
    ld e,0
customKeyCode:
    READ_BOUND_KEY #bf,1
    READ_BOUND_KEY #7f,1
    READ_BOUND_KEY #fd,1
    READ_BOUND_KEY #fb,1
    READ_BOUND_KEY #df,2
    READ_BOUND_KEY #df,1
    ld a,e
    ret
    assert $-customKeyCode=6*10+2
