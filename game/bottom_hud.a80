; Clear the entire character row in each bitmap bank and set its attributes once.
hudBottomNormal:
    ld d,HUD_BITMAP_HIGH
    jr hudBottom
hudBottomShadow:
    ld d,HUD_BITMAP_HIGH+#80
hudBottom:
    push de
    call hudClearBottom
    pop de
    push de
    ld a,(selectedLevel)
    inc a                       ; level index is zero-based
    ld hl,hudLevelNumber
    cp 10
    jr c,.units
    ld (hl),'1'
    inc hl
    sub 10
.units:
    add a,'0'
    ld (hl),a
    inc hl
    ld (hl),0
    ld hl,hudLevelText
    ld e,HUD_BITMAP_LOW
    call drawScreenText
hudLevelDrawn:
    pop de
    ret

hudClearBottom:
    ld e,HUD_BITMAP_LOW
    ld b,8
.row:
    xor a
    dup 31 : ld (de),a : inc e : edup
    ld (de),a
    ld e,HUD_BITMAP_LOW
    inc d
    djnz .row
    inc d
    inc d
    ld a,HUD_ATTR
    dup 31 : ld (de),a : inc e : edup
    ld (de),a
    ret

hudLevelText: db "LEVEL "
hudLevelNumber: db "1",0,0      ; room for levels 10-16
