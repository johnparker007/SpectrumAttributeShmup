; A is a zero-based level number. The caller runs with rendering disabled.
loadLevel:
    ld (selectedLevel),a
    push af
    ld a,1
    call swapPage
    pop af
    add a,a
    ld e,a
    ld d,0
    ld hl,packedLevels
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,sourceTileMap
    ; Avoid an interrupt changing paging mid-copy or affecting decode timing.
    di
levelUnpackBegin:
    call dzx0_standard
levelUnpackEnd:
    xor a
    call swapPage
levelPageRestored:
    ifdef LEVEL_WAVES
        ld a,(selectedLevel)
        call configureScenery
        ld a,(selectedLevel)
        call configureLevelWaves
        ld a,(selectedLevel)
enemyLoadBegin:
        call loadEnemyRoster
enemyLoadEnd:
    endif
    ei
    ret

    include "dzx0_standard.asm"

selectedLevel: db 0

    ifdef LEVEL_WAVES
; Fixed RAM trampoline. Both the source and destination banks use #c000.
unpackEnemyPacket:
    ld a,6
    call swapPage
    ld de,attrBuffer
    call dzx0_standard
    xor a
    jp swapPage
    endif
