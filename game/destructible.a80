; The live barrel has 18 columns. Columns 0–7 share their tile with 10–17
; after streaming; columns 8 and 9 have no second copy.
SCENERY_BLAST_SLOTS equ 8
SCENERY_BLAST_TICKS equ 6
    assert tileMapWidth=18 && low tileMap=0
    assert tileMapWidth*tileMapHeight<=256

configureScenery:
    ld l,a
    ld h,0
    ld de,levelScenery
    add hl,de
    ld a,(hl)
    ld (sceneryEnabled),a
    ret

sceneryStep:
    ld a,(sceneryEnabled)
    or a
    ret z
    call sceneryAgeBlasts
    dup PLAYER_PAIRS, slot
        ld hl,(player_pairs+2*slot)
        ld a,l
        inc a
        jr z,1f
        call sceneryProbePair
        jr c,1f
        ld a,#ff
        ld (player_pairs+2*slot),a
        call sceneryStartBlast
1:
    edup
    ret

; HL = paired shot (X,Y). Return carry clear, HL = hit cell, E = column.
; Both shot lanes share X. Their row origins are either equal or 18 apart.
sceneryProbePair:
    ld a,(tileMapScroll_H)
    add a,l
    ld c,a
    rrca : rrca : rrca
    and #1f
    ld e,a
    ld b,h
    ld l,h
    ld h,high sceneryRowOffsets
    ld a,(hl)
    add a,e
    ld l,a
    ld h,high tileMap
    call sceneryTestCell
    ret nc
    assert PLAYER_PAIR_GAP=4
    bit 2,b                      ; BIT preserves carry on a miss
    ret z
    ld a,l
    add a,tileMapWidth
    ld l,a
sceneryTestCell:
    ld a,(hl)
    cp DESTRUCTIBLE_TILE
    ret nc
    ld a,c
    and 7
    cp 7
    ret c
    inc l                        ; right dot crosses a column boundary
    ld a,(hl)
    cp DESTRUCTIBLE_TILE
    jr c,.miss
    inc e
    ret
.miss:
    dec l
    ret

sceneryStartBlast:
    ld c,l
    ld a,e
    cp 8
    jr nc,.checkRight
    ld a,l
    add a,10
    ld c,a
    jr .find
.checkRight:
    cp 10
    jr c,.find
    ld a,l
    sub 10
    ld c,a                       ; keep HL on the cell actually struck
.find:
    dup SCENERY_BLAST_SLOTS, slot
        ld a,(sceneryBlasts+3*slot+2)
        or a
        jr nz,1f
        ld de,sceneryBlasts+3*slot
        jr .start
1:
    edup
    ld e,SCENERY_MOUNT           ; reveal the crater immediately if the pool is full
    ld d,(hl)
    jr sceneryReplace
.start:
    ld a,l : ld (de),a : inc de
    ld a,c : ld (de),a : inc de
    ld a,SCENERY_BLAST_TICKS : ld (de),a
    ld a,(sceneryBlastCount)
    inc a
    ld (sceneryBlastCount),a
    ld e,BLAST_TILE
    ld d,(hl)

; HL = primary, C = alias low byte, D = old tile, E = replacement.
; The first nine world columns have no streaming copy at initial load.
sceneryReplace:
    ld (hl),e
    ld l,c
    ld a,(hl)
    cp d
    ret nz
    ld (hl),e
    ret

sceneryAgeBlasts:
    ld a,(sceneryBlastCount)
    or a
    ret z
    ld b,a                       ; collect retirements in B for the whole pass
    dup SCENERY_BLAST_SLOTS, slot
        ld hl,sceneryBlasts+3*slot+2
        ld a,(hl)
        or a
        call nz,sceneryAgeOne
    edup
    ld a,b
    ld (sceneryBlastCount),a
    ret

sceneryAgeOne:
    dec (hl)
    jr z,.finish
    ; Both ticks of a stage must still address the original blast. A new
    ; column streamed into the barrel retires the slot without marking it.
    add a,low sceneryBlastStages
    ld e,a
    ld d,high sceneryBlastStages
    ld a,(de)
    ld d,a                       ; expected stage
    ld e,(hl)                    ; remaining ticks
    push hl
    dec hl
    ld c,(hl)
    dec hl
    ld l,(hl)
    ld h,high tileMap
    ld a,(hl)
    cp d
    jr nz,.overwritten
    pop af                       ; discard saved timer address
    bit 0,e
    ret nz
    ld e,d
    inc e
    jp sceneryReplace
.overwritten:
    pop hl
    ld (hl),0
    dec b
    ret

.finish:
    dec hl
    ld c,(hl)
    dec hl
    ld l,(hl)
    ld h,high tileMap
    ld a,(hl)
    cp BLAST_TILE+2
    ld de,(BLAST_TILE+2)*256+SCENERY_MOUNT
    call z,sceneryReplace
    dec b
    ret

resetScenery:
    ld (sceneryBlastCount),a     ; caller supplies zero
    ld hl,sceneryBlasts
    dup SCENERY_BLAST_SLOTS
        inc hl : inc hl
        ld (hl),a
        inc hl
    edup
    ret

sceneryEnabled: db 0
sceneryBlastCount: db 0
sceneryBlasts: defs SCENERY_BLAST_SLOTS*3
    align 8
sceneryBlastStages: db 0,BLAST_TILE+2,BLAST_TILE+2
    db BLAST_TILE+1,BLAST_TILE+1,BLAST_TILE,BLAST_TILE
levelScenery: incbin "level_targets.bin"

; Y can be any logical screen row. The page-aligned table avoids a second
; multiply-by-18 for the lower lane of a shot. It lives in pageable bank 0.
    align 256
sceneryRowOffsets:
    dup 48,y : db (y/8)*tileMapWidth : edup
