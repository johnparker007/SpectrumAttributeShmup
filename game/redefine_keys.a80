redefineKeys:
    call clearMenuScreen
    ld hl,redefineTitle
    ld de,#4809
    call drawScreenText
    ld hl,redefineAllowed
    ld de,#5028
    call drawScreenText
    ld hl,redefineReserved
    ld de,#5064
    call drawScreenText
    xor a
    ld (pendingKeyCount),a
.prompt:
    ld a,(pendingKeyCount)
    add a,a
    ld e,a
    ld d,0
    ld hl,redefinePrompts
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,#488a
    call drawScreenText
.release:
    call waitMenuKeyRelease
.wait:
    call menuFrame
    call readMenuKey
    cp 40
    jr nc,.wait
    ld c,a
    ld e,a
    ld d,0
    ld hl,menuKeyNames
    add hl,de
    ld a,(hl)
    cp 13
    jp z,waitMenuKeyRelease
    or a
    jr z,.release                ; Shift keys are reserved
    cp 'M'
    jr z,.release
    ld hl,pendingKeys
    ld a,(pendingKeyCount)
    or a
    jr z,.save
    ld b,a
.duplicate:
    ld a,(hl)
    cp c
    jr z,.release
    inc hl
    djnz .duplicate
.save:
    ld (hl),c
    ld hl,pendingKeyCount
    inc (hl)
    ld a,(hl)
    cp 5
    jr nz,.prompt
    call applyCustomKeys
    jp waitMenuKeyRelease

applyCustomKeys:
    call makeKeyReadPlan
    ; The second entry is Fire, after the fixed Enter binding.
    ld hl,(keyReadPlan+2)
    ld a,l
    ld (menuKeyboardFire+1),a
    ld a,h
    ld (menuKeyboardFire+5),a
    ld hl,0
    ld (cachedKeyRows),hl
    xor a
    ld (cachedKeyRows+2),a
    ld ix,keyReadPlan
    ld de,customKeyCode
    ld b,6
.key:
    push bc
    call emitKeyRead
    ld a,#e6                     ; AND mask
    ld (de),a
    inc de
    ld a,(ix+1)
    ld (de),a
    inc de
    ld hl,customKeyBit
    ld bc,customKeyExit-customKeyBit
    ldir
    inc ix : inc ix
    pop bc
    djnz .key
    ld hl,customKeyExit
    ld bc,customKeyTemplatesEnd-customKeyExit
    ldir

    ld hl,readCustomControls
    ld (menuReaders),hl
    ld (controlReader+1),hl
    ret

makeKeyReadPlan:
    ld ix,customReadOrder
    ld de,keyReadPlan
    ld b,6
.key:
    push bc
    ld l,(ix)
    ld h,0
    ld bc,pendingKeys
    add hl,bc
    ld a,(hl)
    add a,a
    ld l,a
    ld h,0
    ld bc,menuKeyBindings
    add hl,bc
    ldi : ldi                    ; physical row selector and active-low mask
    inc ix
    pop bc
    djnz .key
    ret

; IX points to the next key, B includes that key, DE is the code cursor.
emitKeyRead:
    ld c,(ix)
    ld hl,(cachedKeyRows)
    ld a,c
    cp l
    ld a,#7a                     ; LD A,D
    jr z,.emit
    ld a,c
    cp h
    ld a,#7c                     ; LD A,H
    jr z,.emit
    ld a,(cachedKeyRows+2)
    cp c
    ld a,#7d                     ; LD A,L
    jr z,.emit

    ld a,#3e                     ; LD A,row
    ld (de),a
    inc de
    ld a,c
    ld (de),a
    inc de
    ld a,#db                     ; IN A,(#fe)
    ld (de),a
    inc de
    ld a,#fe
    ld (de),a
    inc de
    dec b
    ret z
    push ix
    pop hl
.scan:
    inc hl : inc hl
    ld a,(hl)
    cp c
    jr z,.cache
    djnz .scan
    ret
.cache:
    ; Six keys can share at most three rows. Cache their sampled bytes in D, H and L.
    ld a,(cachedKeyRows)
    or a
    ld a,c
    jr nz,.second
    ld (cachedKeyRows),a
    ld a,#57                     ; LD D,A
    jr .emit
.second:
    ld a,(cachedKeyRows+1)
    or a
    ld a,c
    jr nz,.third
    ld (cachedKeyRows+1),a
    ld a,#67                     ; LD H,A
    jr .emit
.third:
    ld (cachedKeyRows+2),a
    ld a,#6f                     ; LD L,A
.emit:
    ld (de),a
    inc de
    ret

customKeyBit:
    sub 1
    rl e
customKeyExit:
    ld a,e
    ret
customKeyTemplatesEnd:

waitMenuKeyRelease:
    call menuFrame
    call readMenuKey
    cp #ff
    jr nz,waitMenuKeyRelease
    ret

; Return a physical key index, #ff for no key, or #fe for multiple keys.
readMenuKey:
    ld bc,#fefe
    ld de,#ff00
.row:
    in a,(c)
    cpl
    and #1f
    jr z,.nextRow
    bit 7,d
    jr z,.multiple
    ld h,a
    dec a
    and h
    jr nz,.multiple
    ld a,e
.findBit:
    srl h
    jr c,.found
    inc a
    jr .findBit
.found:
    ld d,a
.nextRow:
    rlc b
    ld a,e
    add a,5
    ld e,a
    cp 40
    jr nz,.row
    ld a,d
    ret
.multiple:
    ld a,#fe
    ret

redefineTitle: db "REDEFINE KEYS",0
redefineAllowed: db "A-Z 0-9 SPACE",0
redefineReserved: db "M MENU KEY  ENTER CANCEL",0
redefinePrompts: dw promptLeft,promptRight,promptUp,promptDown,promptFire
promptLeft:  db "PRESS LEFT ",0
promptRight: db "PRESS RIGHT",0
promptUp:    db "PRESS UP   ",0
promptDown:  db "PRESS DOWN ",0
promptFire:  db "PRESS FIRE ",0
pendingKeyCount: db 0
pendingKeys: defs 5
    db 30                        ; Enter is fixed, but can share a row
customReadOrder: db 5,4,3,2,0,1   ; Enter, Fire, Down, Up, Left, Right, for RL E
keyReadPlan: defs 6*2
cachedKeyRows: defs 3

menuKeyNames: db 0,"ZXCVASDFGQWERT1234509876POIUY",13,"LKJH ",0,"MNB"
    assert $-menuKeyNames=40
menuKeyBindings:
    dup 40, key
        db #ff-(1<<(key/5)),1<<(key%5)
    edup
