; The banked music player restores page 0 before ticking these effects.
startShotSound:
    ld hl,shotSound
    ld (shotSoundCursor),hl
    ret

startExplosionSound:
    push hl
    ld hl,explosionNoise
    ld (explosionNoiseCursor),hl
    pop hl
    ret

resetSoundEffects:
    ld hl,0
    ld (explosionNoiseCursor),hl
    ld (shotSoundCursor),hl
    ret

soundEffectsTick:
    call advanceShotSound
    ld d,e                      ; shot volume
    call advanceExplosionSound ; explosion volume in E
    ld a,(soundMusicMixer)
    or #24                      ; disable both generators on C when idle
    inc d
    dec d
    jr z,.noise
    and #fb                     ; enable the shot tone
.noise:
    ld h,a
    ld a,e
    or a
    jr z,.volume
    res 5,h                     ; enable the explosion noise
.volume:
    cp d
    jr nc,.writeVolume
    ld e,d                      ; use the louder effect's volume on C
.writeVolume:
    ld a,10
    call writeSoundEffect
    ld a,h
    ld hl,soundMixerWritten
    cp (hl)
    ret z
    ld (hl),a
    ld e,a
    ld a,7
    jp writeSoundEffect

advanceExplosionSound:
    ld hl,(explosionNoiseCursor)
    ld e,0
    ld a,h
    or a
    ret z
    ld e,(hl)
    inc hl
    ld a,6
    call writeSoundEffect
    ld e,(hl)
    inc hl
    ld a,l
    cp low explosionNoiseEnd
    jr nz,.save
    ld hl,0
.save:
    ld (explosionNoiseCursor),hl
    ret

advanceShotSound:
    ld hl,(shotSoundCursor)
    ld e,0
    ld a,h
    or a
    ret z
    ld e,(hl)
    inc hl
    ld a,4
    call writeSoundEffect
    ld e,(hl)
    inc hl
    ld a,5
    call writeSoundEffect
    ld e,(hl)
    inc hl
    ld a,l
    cp low shotSoundEnd
    jr nz,.save
    ld hl,0
.save:
    ld (shotSoundCursor),hl
    ret

writeSoundEffect:
    ld bc,#fffd
soundEffectSelect:
    out (c),a
    ld b,#bf
soundEffectWrite:
    out (c),e
    ret

shotSoundCursor: dw 0
explosionNoiseCursor: dw 0
shotSound: incbin "gfx/shot-sound.bin"
shotSoundEnd:
    assert shotSoundEnd-shotSound < 256
explosionNoise: incbin "gfx/explosion-noise.bin"
explosionNoiseEnd:
    assert explosionNoiseEnd-explosionNoise < 256
