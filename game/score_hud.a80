; Top-right fixed bitmap over the two logical attribute rows of character row 0.
HUD_X equ 20
HUD_WIDTH equ 12
HUD_DIGIT_RIGHT equ HUD_X+9      ; two trailing zeroes make each kill worth 100
HUD_ATTR equ #47                 ; bright white on black

hudInit:
    ld d,#40
    call hudInitialBitmap
    SET_PAGE 7
    ld d,#c0
    call hudInitialBitmap
    SET_PAGE 0
    ret

hudInitialBitmap:
    ld hl,hudInitialRows
.row:
    ld e,HUD_X
    ld b,HUD_WIDTH
.byte:
    ld a,(hl)
    ld (de),a
    inc hl
    inc e
    djnz .byte
    inc d
    ld a,d
    and 7
    jr nz,.row
    ret

; Keep the four significant digits in packed BCD. Saturate at 999900.
hudAward:
    ld hl,(hudScore)
    ld a,l
    add a,1
    daa
    ld l,a
    ld a,h
    adc a,0
    daa
    ret c
    ld h,a
    ld (hudScore),hl
    ld a,1
    ld (hudPending),a
    ret

; One video frame either selects a changed digit or copies one row of the
; selected glyph to both bitmap banks. A digit in progress keeps its glyph.
hudStep:
    ld a,(hudRow)
    cp 8
    jr c,.draw
    ld a,(hudPending)
    or a
    ret z
    jp hudSelectDigit
.draw:
    ld d,a
    inc a
    ld (hudRow),a
    ld a,d
    add a,#40
    ld d,a
    ld a,(hudColumn)
    ld e,a
    ld hl,(hudGlyph)
    ld a,(hl)
    inc hl
    ld (hudGlyph),hl
hudBitmapWrite:
    ld (de),a
    ld h,a
    set 7,d
    ld bc,#7ffd
    ld a,#17
hudPageIn:
    out (c),a
    ld a,h
hudShadowWrite:
    ld (de),a
    ld a,#10
hudPageOut:
    out (c),a
    ret

hudSelectDigit:
    ld de,(hudScore)
    ld hl,hudDrawn
    ld b,HUD_DIGIT_RIGHT
    ld a,(hl)
    xor e
    jr nz,.changed
    dec b
    dec b
    inc hl
    ld e,d
    ld a,(hl)
    xor e
    jr nz,.changed
    ld (hudPending),a
    ret
.changed:
    and 15
    jr z,.highNibble
    ld a,(hl)
    and #f0
    ld c,a
    ld a,e
    and 15
    or c
    ld (hl),a
    and 15
    jr .select
.highNibble:
    dec b
    ld (hl),e                   ; low nibble already matches
    ld a,e
    dup 4 : rrca : edup
    and 15
.select:
    add a,a
    add a,a
    add a,a
    ld l,a
    ld h,0
    ld de,hudDigits
    add hl,de
    ld (hudGlyph),hl
    ld a,b
    ld (hudColumn),a
    xor a
    ld (hudRow),a
    ret

; Tiles/sprites replace the attribute buffer each game tick, so repaint
; just the strip's 24 attribute bytes after composition.
hudAttributes:
    ld hl,(attrPointer)
    ld de,HUD_X
    add hl,de
    ld a,HUD_ATTR
    dup HUD_WIDTH-1 : ld (hl),a : inc hl : edup
    ld (hl),a
    ld de,ROW_BYTES-HUD_WIDTH+1
    add hl,de
    dup HUD_WIDTH-1 : ld (hl),a : inc hl : edup
    ld (hl),a
    ret

hudScore: dw 0
hudDrawn: dw 0                  ; last glyph selected for each digit
hudPending: db 0
hudRow: db 8
hudColumn: db HUD_DIGIT_RIGHT
hudGlyph: dw hudDigits
hudDigits: incbin "score_digits.bin"
hudInitialRows: incbin "score_initial.bin"
