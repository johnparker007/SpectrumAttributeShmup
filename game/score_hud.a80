; Score and lives use the same glyph queue in both layouts.
HUD_WIDTH equ STARTING_LIVES+1+6
HUD_X equ 32-HUD_WIDTH
HUD_DIGIT_RIGHT equ 29          ; columns 30 and 31 are startup-only zeroes
HUD_ATTR equ #47                 ; bright white on black
HUD_SCORE_DIRTY equ 0
HUD_LIVES_DIRTY equ 1
    ifdef BOTTOM_HUD
HUD_BITMAP_HIGH equ #50
HUD_BITMAP_LOW equ #e0
    else
HUD_BITMAP_HIGH equ #40
HUD_BITMAP_LOW equ 0
    endif

hudInit:
    ifdef BOTTOM_HUD
        call hudBottomNormal
    else
        ld d,HUD_BITMAP_HIGH
    endif
    call hudInitialBitmap
    SET_PAGE 7
    ifdef BOTTOM_HUD
        call hudBottomShadow
    else
        ld d,HUD_BITMAP_HIGH+#80
    endif
    call hudInitialBitmap
    SET_PAGE 0
    ret

hudInitialBitmap:
    ld hl,hudInitialRows
.row:
    ld e,HUD_BITMAP_LOW+HUD_X
    ld b,HUD_WIDTH
.byte:
    ld a,(hl)
    ld (de),a
    inc hl
    inc e
    djnz .byte
    inc d
    ld a,d
    and 7
    jr nz,.row
    ret

; Keep the four significant digits in packed BCD. Saturate at 999900.
hudAward:
    ld hl,(hudScore)
    ld a,l
    add a,1
    daa
    ld l,a
    ld a,h
    adc a,0
    daa
    ret c
    ld h,a
    ld (hudScore),hl
    ld hl,hudPending
    set HUD_SCORE_DIRTY,(hl)
    ret

; One video frame either selects a changed cell or copies one row of the
; selected glyph to both bitmap banks. A digit in progress keeps its glyph.
hudStep:
    ld a,(hudRow)
    cp 8
    jr c,.draw
    ld a,(hudPending)
    or a
    ret z
    bit HUD_LIVES_DIRTY,a
    jp z,hudSelectDigit
    jp hudSelectLife
.draw:
    ld d,a
    inc a
    ld (hudRow),a
    ld a,d
    add a,HUD_BITMAP_HIGH
    ld d,a
    ld a,(hudColumn)
    ld e,a
    ld hl,(hudGlyph)
    ld a,(hl)
    inc hl
    ld (hudGlyph),hl
hudBitmapWrite:
    ld (de),a
    ld h,a
    set 7,d
    ld bc,#7ffd
    ld a,#17
hudPageIn:
    out (c),a
    ld a,h
hudShadowWrite:
    ld (de),a
    ld a,#10
hudPageOut:
    out (c),a
    ret

hudSelectDigit:
    ld de,(hudScore)
    ld hl,hudDrawn
    ld b,HUD_DIGIT_RIGHT
    ld a,(hl)
    xor e
    jr nz,.changed
    dec b
    dec b
    inc hl
    ld e,d
    ld a,(hl)
    xor e
    jr nz,.changed
    ld hl,hudPending
    res HUD_SCORE_DIRTY,(hl)
    ret
.changed:
    and 15
    jr z,.highNibble
    ld a,(hl)
    and #f0
    ld c,a
    ld a,e
    and 15
    or c
    ld (hl),a
    and 15
    jr .select
.highNibble:
    dec b
    ld (hl),e                   ; low nibble already matches
    ld a,e
    dup 4 : rrca : edup
    and 15
.select:
    add a,a
    add a,a
    add a,a
    ld l,a
    ld h,0
    ld de,hudDigits
    add hl,de

hudQueueGlyph:
    ld (hudGlyph),hl
    ld a,b
    ifdef BOTTOM_HUD
        add a,HUD_BITMAP_LOW
    endif
    ld (hudColumn),a
    xor a
    ld (hudRow),a
    ret

hudSelectLife:
    ld a,(playerLives)
    ld hl,hudLivesDrawn
    cp (hl)
    jr z,.settled
    ld de,hudLifeIcon
    jr nc,.restore
    dec (hl)
    ld a,(hl)
    ld de,hudLifeBlank
    jr .queue
.restore:
    ld a,(hl)
    inc (hl)
.queue:
    add a,HUD_X
    ld b,a
    ex de,hl
    jr hudQueueGlyph
.settled:
    ld hl,hudPending
    res HUD_LIVES_DIRTY,(hl)
    ret

; Tiles/sprites replace the attribute buffer each game tick, so repaint
; just the strip's two rows of attributes after composition.
    ifdef BOTTOM_HUD
    defs 48,0                    ; preserve the timing-tested fixed-bank layout
    else
hudAttributes:
    ld hl,(attrPointer)
    ld de,HUD_X
    add hl,de
    ld a,HUD_ATTR
    dup HUD_WIDTH-1 : ld (hl),a : inc hl : edup
    ld (hl),a
    ld de,ROW_BYTES-HUD_WIDTH+1
    add hl,de
    dup HUD_WIDTH-1 : ld (hl),a : inc hl : edup
    ld (hl),a
    ret
    endif

hudScore: dw 0
hudDrawn: dw 0                  ; last glyph selected for each digit
hudLivesDrawn: db STARTING_LIVES
hudPending: db 0
hudRow: db 8
hudColumn: db HUD_BITMAP_LOW+HUD_DIGIT_RIGHT
hudGlyph: dw hudDigits
hudDigits: incbin "score_digits.bin"
hudLifeIcon: incbin "hud_life_icon.bin"
hudLifeBlank: defs 8,0
hudInitialRows: incbin "hud_initial.bin"
    assert $-hudInitialRows=8*HUD_WIDTH
