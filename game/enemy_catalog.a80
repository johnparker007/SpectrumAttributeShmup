; Bank 0. One 256-byte art page per resident species, indexed by waveKind.
; Slots 0 and 1 are the sine and Z ships. Other slots also own a path page.
; Even/odd samples turn inward from the top/bottom half. Bits 0..4 are
; delta Y + 16, bit 5 adds a second X step, and bits 6..7 select a gun.
; Unused offscreen samples hold the bearings, seven entry pairs and gates.
    include "enemy_manifests.a80"
residentCount: db 0
residentDelays: defs 8

loadEnemyRoster:
    add a,a
    ld e,a
    ld d,0
    ld hl,enemyManifests
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld a,(hl)
    ld (residentCount),a
    inc hl
    push hl
    pop ix
    ld iyh,high enemyArt
.next:
    ld l,(ix)
    ld h,(ix+1)
    call unpackEnemyPacket
    ld hl,attrBuffer
    ld d,iyh
    ld e,0
    ld bc,256
.artCopy:
    ldir
    ld a,iyh
    sub high enemyArt
    ld e,a
    ld d,0
    ld hl,residentDelays
    add hl,de
    ld a,(ix+2)
    ld (hl),a
    ld b,(ix+3)
    ld de,4
    add ix,de
    ld a,iyh
    cp high enemyArt+2
    jr c,.loaded
    add a,high catalogPaths-high enemyArt-2
    push bc
    ld d,a
    ld e,0
    ld hl,attrBuffer+256
    ld bc,256
.pathCopy:
    ldir
    pop bc
    ld h,a
    ld a,b
    or a
    jr z,.loaded
    ld d,h
    ld e,CATALOG_GATES
.gun:
    ld a,(de)                   ; sample crossed on a single or double step
    inc e
    ld l,a
    ld a,(de)
    inc e
    ld c,a                      ; bearing selector for either entry direction
    or (hl)
    ld (hl),a
    inc l
    ld a,c
    or (hl)
    ld (hl),a
    djnz .gun
.loaded:
    inc iyh
    ld a,iyh
    sub high enemyArt
    ld hl,residentCount
    cp (hl)
    jr nz,.next
    ; This is the future playfield buffer on the first launch from the menu.
    ld hl,attrBuffer
    ld de,attrBuffer+1
    ld bc,511
    ld (hl),0
    ldir
    ret

spawnCatalogShip:
    ld a,(waveKind)
    add a,high enemyArt
    ld b,a
    ld c,0
    add a,high catalogPaths-high enemyArt-2
    ld d,a
    ld a,(waveIndex)
    add a,a : add a,a           ; carry flips the whole formation on the next pass
    ld a,(waveRemaining)
    rla
    add a,CATALOG_ENTRIES-2
    ld e,a
    ld a,(de)
    ld e,a
    and 63
    ld (hl),a
    ld a,e
    rlca                        ; carry selects this ship's inward direction
    ld a,d
    rla
    ld (ix),a
    jp writeSpawnArt

moveCatalogShip:
    ld a,b
    xor c
    rrca                         ; stagger adjacent ships across game ticks
    jp c,stepWave.skipY
    dec (hl)
    ld a,(hl)
    cp #fb
    jr nz,.sample
    ld (hl),HIDDEN_BOX
    jp stepWave.skipY
.sample:
    exx
    ld a,(de)
    scf
    rra                         ; high path address and the mirrored-entry bit
    ld h,a
    exx
    ld a,(hl)
    rla
    exx
    ld l,a
.readSample:
    ld a,(hl)
.shotMask:
    and #ff                     ; one scripted trigger is serviced per tick
    cp 32
    jr nc,.marked
.position:
    ld h,high shipTrajectories  ; green slots reuse the alternate H
    exx
    inc hl
    sub 16
    add a,(hl)
    ld (hl),a
.positionWritten:
    jp stepWave.advance
.marked:
    bit 5,a
    jr z,.gun
    exx
    dec (hl)                    ; Y and the gun belong to the landing column
    exx
    and #df
    cp 32
    jr c,.position
.gun:
    ld (finishCatalogShots.path+1),hl
    and 31
    ld h,high shipTrajectories
    exx
    inc hl
    sub 16
    add a,(hl)
    ld (hl),a
.gunPositionWritten:
    ; These coordinates stay live until Frame 2. Mask just the gun bits for
    ; the remaining ships this tick, so a whole salvo has a bounded cost.
    ld (finishCatalogShots.ship+1),hl
    ld a,#3f
    ld (moveCatalogShip.shotMask+1),a
    jp stepWave.advance

finishCatalogShots:
    ld a,(moveCatalogShip.shotMask+1)
    inc a
    jp z,mainLoop
    ld a,#ff
    ld (moveCatalogShip.shotMask+1),a
    ld hl,(enemyWrite)
    ld a,(hl)
    inc a
    jp nz,mainLoop              ; pool full, discard this opportunity
    ld a,(playerLives)
    or a
    jp z,mainLoop
.path:
    ld hl,0                     ; marked sample for the winning ship
    ld a,(hl)
    and #c0
    rlca : rlca : rlca
    add a,CATALOG_BEARINGS-2
    ld c,a
    ld a,l
    and 1
    add a,c
    ld l,a
    ld d,(hl)
.ship:
    ld hl,0
    ld a,(hl)
    add a,2
    ld c,a
    dec hl
    ld b,(hl)
catalogBearing:
    bit 0,d
    call nz,aimIncoming
catalogShotReady:
    call emitIncoming
    jp mainLoop
